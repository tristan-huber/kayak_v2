          "interpreterVersion": 1,
          "code": "function run(target: Assembly, mover: Assembly = undefined, flip: boolean = false, offset: number = 0) {\n  const targetEdges = target.getSelectedEdges();\n  if (targetEdges.length != 1) {\n    throw Error(\"Must have exactly one selected edge on Target. was: \" + targetEdges.length)\n  }\n  const otherEdges = mover.getSelectedEdges();\n  if (otherEdges.length != 1) {\n    throw Error(\"Must have exactly one selected edge on Mover. was: \" + otherEdges.length);\n  }\n\n  const targetEdge = targetEdges[0]\n  const otherEdge = otherEdges[0]\n  \n  if (offset > targetEdge.length) {\n    console.warn(\"offset \", offset, \" is longer than target edge length \", targetEdge.length)\n  }\n\n  offset = Math.min(targetEdge.length, offset) / targetEdge.length\n\n  // compute transpose.\n  // In all case align mover edge so it's start point (or end point if flipped)\n  // is coincident with target.pointAt(offset)\n  \n  const otherPoint = flip ? otherEdge.endPoint : otherEdge.startPoint\n  const otherDir = flip ? otherEdge.tangentAt(otherEdge.length).multiply(-1) : otherEdge.tangentAt(0)\n  console.log(otherDir.toTuple())\n  const targetPoint = targetEdge.pointAt(offset)\n  const transpose = targetPoint.sub(otherPoint)\n  console.log(\"computed transpose: \", transpose)\n  \n  // compute rotation\n  const targetDir = targetEdge.tangentAt(offset)\n  const rotationDeg = targetDir.getAngle(otherDir)\n  const rotationVec = targetDir.cross(otherDir).normalize().multiply(-1)\n\n  // apply transforms\n  const moved = mover.onLeafs((leaf) => {\n    if (leaf.geometry instanceof replicad.Drawing) {\n      throw Error(\"rotate align not supported for drawings\")\n    }\n    leaf.geometry = leaf.geometry.translate(transpose.x, transpose.y, transpose.z)\n      .rotate(rotationDeg, targetPoint, rotationVec)\n    return leaf;\n  })\n  if (moved == null) {\n    throw new Error(\"got empty assembly after moving. Should be impossible.\")\n  }\n  return new Assembly({\n    geometry: [target, moved]\n  })\n\n}",
          "compiledCode": "\"use strict\";\nfunction run(target, mover = undefined, flip = false, offset = 0) {\n    const targetEdges = target.getSelectedEdges();\n    if (targetEdges.length != 1) {\n        throw Error(\"Must have exactly one selected edge on Target. was: \" + targetEdges.length);\n    }\n    const otherEdges = mover.getSelectedEdges();\n    if (otherEdges.length != 1) {\n        throw Error(\"Must have exactly one selected edge on Mover. was: \" + otherEdges.length);\n    }\n    const targetEdge = targetEdges[0];\n    const otherEdge = otherEdges[0];\n    if (offset > targetEdge.length) {\n        console.warn(\"offset \", offset, \" is longer than target edge length \", targetEdge.length);\n    }\n    offset = Math.min(targetEdge.length, offset) / targetEdge.length;\n    // compute transpose.\n    // In all case align mover edge so it's start point (or end point if flipped)\n    // is coincident with target.pointAt(offset)\n    const otherPoint = flip ? otherEdge.endPoint : otherEdge.startPoint;\n    const otherDir = flip ? otherEdge.tangentAt(otherEdge.length).multiply(-1) : otherEdge.tangentAt(0);\n    console.log(otherDir.toTuple());\n    const targetPoint = targetEdge.pointAt(offset);\n    const transpose = targetPoint.sub(otherPoint);\n    console.log(\"computed transpose: \", transpose);\n    // compute rotation\n    const targetDir = targetEdge.tangentAt(offset);\n    const rotationDeg = targetDir.getAngle(otherDir);\n    const rotationVec = targetDir.cross(otherDir).normalize().multiply(-1);\n    // apply transforms\n    const moved = mover.onLeafs((leaf) => {\n        if (leaf.geometry instanceof replicad.Drawing) {\n            throw Error(\"rotate align not supported for drawings\");\n        }\n        leaf.geometry = leaf.geometry.translate(transpose.x, transpose.y, transpose.z)\n            .rotate(rotationDeg, targetPoint, rotationVec);\n        return leaf;\n    });\n    if (moved == null) {\n        throw new Error(\"got empty assembly after moving. Should be impossible.\");\n    }\n    return new Assembly({\n        geometry: [target, moved]\n    });\n}\n"
        }
      ],
