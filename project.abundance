            {
              "atomType": "Code",
              "x": 0.43310546875,
              "y": 0.75625,
              "uniqueID": "id-43730",
              "ioValues": [
                {
                  "name": "primaryGuideWire",
                  "ioValue": "__GEOMETRY_INPUT__"
                },
                {
                  "name": "secondaryGuideWire",
                  "ioValue": "__GEOMETRY_INPUT__"
                },
                {
                  "name": "holes",
                  "ioValue": "__GEOMETRY_INPUT__"
                },
                {
                  "name": "numRulings",
                  "ioValue": 24
