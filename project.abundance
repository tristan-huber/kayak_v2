              "name": "rulings",
              "ioValue": 150
            }
          ],
          "topLevel": false,
          "allAtoms": [
            {
              "atomType": "Output",
              "x": 0.98,
              "y": 0.5,
              "uniqueID": "id-43729",
              "ioValues": [
                {
                  "name": "number or geometry",
