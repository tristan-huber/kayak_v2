                }
              ]
            },
            {
              "atomType": "Code",
              "x": 0.46223958333333337,
              "y": 0.3485714285714286,
              "uniqueID": "id-83627",
              "ioValues": [
                {
                  "name": "facesOf",
                  "ioValue": "__GEOMETRY_INPUT__"
                },
                {
                  "name": "normal",
                  "ioValue": [
                    -1,
                    0,
                    0
                  ]
                },
                {
                  "name": "toleranceDeg",
                  "ioValue": 0
                },
                {
                  "name": "u",
                  "ioValue": 0.5
