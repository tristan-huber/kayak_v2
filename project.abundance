          "interpreterVersion": 1,
          "code": "/**\n * Extracts the ruling lines from a ruled surface using the primary/secondary\n * edge framework from Wang et al. (JCISE 2021,\n * https://mewangcl.github.io/pubs/JCISEOptmTrgl.pdf).\n *\n * Input must be an Assembly containing a single replicad.Face. The user picks\n * one edge of the outer wire as the \"primary edge\"; that edge plus all\n * non-adjacent edges (cyclic neighbours of the primary are excluded) drive\n * sampling. We sample `numRulings` points on each side, score every possible\n * (primary[i], secondary[j]) ruling by the angular twist between the surface\n * normals at its two endpoints, then DP a minimum-cost monotonic path over\n * that grid to pick the actual rulings.\n *\n *   primaryEdgeIndex → cyclic index into `face.outerWire().edges`. The two\n *                      neighbouring edges are excluded; remaining edges, in\n *                      original cyclic order, form the secondary.\n */\nfunction run(\n  surface: Assembly,\n  numRulings: number = 24,\n  primaryEdgeIndex: number = 0,\n): Assembly {\n  if (!Number.isFinite(numRulings) || numRulings < 2) {\n    throw new Error(\n      \"Develop rulings: numRulings must be an integer ≥ 2 (two rulings \" +\n      \"needed to define a strip).\",\n    );\n  }\n  if (!Number.isFinite(primaryEdgeIndex)) {\n    throw new Error(\"Develop rulings: primaryEdgeIndex must be a number.\");\n  }\n\n  const results: Assembly[] = [];\n  // eslint-disable-next-line @typescript-eslint/no-explicit-any\n  (surface as any).onLeafs((leaf: Assembly) => {\n    // eslint-disable-next-line @typescript-eslint/no-explicit-any\n    if ((leaf.geometry as any) instanceof replicad.Drawing) {\n      console.warn(\"Develop rulings: drawings cannot have rulings extracted\");\n      return leaf;\n    }\n    // eslint-disable-next-line @typescript-eslint/no-explicit-any\n    const faces: any[] =\n      // eslint-disable-next-line @typescript-eslint/no-explicit-any\n      (leaf.geometry as any) instanceof replicad.Face\n        ? // eslint-disable-next-line @typescript-eslint/no-explicit-any\n        [leaf.geometry as any]\n        : // eslint-disable-next-line @typescript-eslint/no-explicit-any\n        ((leaf.geometry as any).faces ?? []);\n    for (const face of faces) {\n      const { rulings, pIdx, pathIJ, totalCost, costGrid } = ruleFace(\n        face,\n        numRulings,\n        primaryEdgeIndex,\n      );\n      results.push(\n        new Assembly({\n          ...leaf,\n          geometry: rulings,\n          tags: [...(leaf.tags ?? []), \"rulings\", \"ruling-primary:\" + pIdx],\n          color: \"blue\",\n          metadata: {\n            costGrid,\n            rulingPath: { path: pathIJ, totalCost },\n          },\n        }),\n      );\n    }\n    return leaf;\n  });\n\n  // eslint-disable-next-line @typescript-eslint/no-explicit-any\n  return results as any;\n}\n\n/**\n * Extract rulings from a single replicad.Face. Returns the ruling assemblies\n * plus metadata so the caller can build the output Assembly.\n */\nfunction ruleFace(\n  // eslint-disable-next-line @typescript-eslint/no-explicit-any\n  face: any,\n  numRulings: number,\n  primaryEdgeIndex: number,\n): {\n  rulings: Assembly[];\n  pIdx: number;\n  pathIJ: [number, number][];\n  totalCost: number;\n  // eslint-disable-next-line @typescript-eslint/no-explicit-any\n  costGrid: any;\n} {\n  const n = Math.max(2, Math.floor(numRulings));\n\n  const resolvedEdgeIndex =\n    primaryEdgeIndex < 0 ? selectBestRulingEdge(face) : primaryEdgeIndex;\n\n  const { primary, secondaryEdges, pIdx } = partitionOuterWire(\n    face,\n    resolvedEdgeIndex,\n  );\n\n  const primarySamples = samplePrimary(primary, n);\n  const secondarySamples = sampleSecondary(secondaryEdges, n);\n\n  const cost = buildCostGrid(face, primarySamples, secondarySamples);\n  logCostStats(pIdx, n, secondaryEdges.length, cost);\n\n  const { path: pathIJ, totalCost } = findOptimalRulingPath(\n    cost,\n    primarySamples,\n    secondarySamples,\n  );\n  console.log(\n    `Develop rulings: path length=${pathIJ.length}, total cost=${totalCost.toExponential(2)}`,\n  );\n\n  const rulings = buildRulingAssemblies(\n    primarySamples,\n    secondarySamples,\n    pathIJ,\n  );\n\n  return {\n    rulings,\n    pIdx,\n    pathIJ,\n    totalCost,\n    costGrid: { n, primaryEdgeIndex: pIdx, cost },\n  };\n}\n\n/**\n * Probe every outer edge of `face` at a low ruling count and return the\n * index that yields the lowest total ruling cost. Used when primaryEdgeIndex < 0.\n */\nconst RULINGS_PROBE_N = 8;\n// eslint-disable-next-line @typescript-eslint/no-explicit-any\nfunction selectBestRulingEdge(face: any): number {\n  const outerWire = face.clone().outerWire();\n  // eslint-disable-next-line @typescript-eslint/no-explicit-any\n  const allEdges: any[] = outerWire.edges ?? [];\n  const m = allEdges.length;\n  let bestIdx = 0;\n  let bestCost = Infinity;\n  for (let k = 0; k < m; k++) {\n    try {\n      const { primary, secondaryEdges } = partitionOuterWire(face, k);\n      const P3 = samplePrimary(primary, RULINGS_PROBE_N);\n      const S3 = sampleSecondary(secondaryEdges, RULINGS_PROBE_N);\n      const cost = buildCostGrid(face, P3, S3);\n      const { totalCost } = findOptimalRulingPath(cost, P3, S3);\n      if (totalCost < bestCost) {\n        bestCost = totalCost;\n        bestIdx = k;\n      }\n    } catch {\n      // edge produced a degenerate partition; skip\n    }\n  }\n  console.log(\n    `Develop rulings auto-select: chose primaryEdgeIndex=${bestIdx} ` +\n    `(cost=${bestCost.toExponential(2)}) from ${m} candidates`,\n  );\n  return bestIdx;\n}\n\n// ─── Shared helpers ─────────────────────────────────────────────────────\n\ntype T3 = [number, number, number];\n\nfunction toT3(v: { x: number; y: number; z: number }): T3 {\n  return [v.x, v.y, v.z];\n}\n\nfunction dist3(a: T3, b: T3): number {\n  return Math.hypot(a[0] - b[0], a[1] - b[1], a[2] - b[2]);\n}\n\n/**\n * Split the face's outer wire into the user-picked primary edge and the\n * \"secondary\" set (all edges except primary + its two cyclic neighbours).\n * Returns the secondary edges in cyclic order starting two past primary.\n */\nfunction partitionOuterWire(\n  // eslint-disable-next-line @typescript-eslint/no-explicit-any\n  face: any,\n  primaryEdgeIndex: number,\n  // eslint-disable-next-line @typescript-eslint/no-explicit-any\n): { primary: any; secondaryEdges: any[]; pIdx: number } {\n  const outerWire = face.clone().outerWire();\n  // eslint-disable-next-line @typescript-eslint/no-explicit-any\n  const allEdges: any[] = outerWire.edges ?? [];\n  const m = allEdges.length;\n  const pIdx = ((Math.floor(primaryEdgeIndex) % m) + m) % m;\n\n  const primary = allEdges[pIdx];\n  const excludedIdx = new Set([pIdx]);\n  if (primary.isClosed) {\n    if (pIdx == 0) {\n      excludedIdx.add(1);\n    } else if (pIdx == allEdges.length - 1) {\n      excludedIdx.add(allEdges.length - 2);\n    } else {\n      console.warn(\"found a closed face with two neighbors..\");\n    }\n  } else {\n    excludedIdx.add((pIdx - 1 + m) % m);\n    excludedIdx.add((pIdx + 1) % m);\n  }\n\n  // eslint-disable-next-line @typescript-eslint/no-explicit-any\n  const secondaryEdges: any[] = [];\n  for (let k = 0; k < m; k++) {\n    const idx = (pIdx + 2 + k) % m;\n    if (!excludedIdx.has(idx)) secondaryEdges.push(allEdges[idx]);\n  }\n  if (secondaryEdges.length === 0) {\n    console.warn(\"less than 4 edges total. this may cause bugs later\")\n    secondaryEdges.push(allEdges[(pIdx + 1) % m])\n  }\n  return { primary, secondaryEdges, pIdx };\n}\n\n/** Sample the primary edge at n evenly-spaced parametric positions. */\n// eslint-disable-next-line @typescript-eslint/no-explicit-any\nfunction samplePrimary(primary: any, n: number): T3[] {\n  const out: T3[] = new Array(n);\n  for (let i = 0; i < n; i++) {\n    const t = n === 1 ? 0 : i / (n - 1);\n    out[i] = toT3(primary.pointAt(t));\n  }\n  return out;\n}\n\n/**\n * Distribute n samples across the secondary edges proportional to their arc\n * length, then snap the sample nearest each shared vertex to that vertex's\n * 3D position so tangent-break corners survive.\n */\nfunction sampleSecondary(\n  // eslint-disable-next-line @typescript-eslint/no-explicit-any\n  secondaryEdges: any[],\n  n: number,\n): T3[] {\n  const secLengths = secondaryEdges.map((e) => e.length);\n  const secTotal = secLengths.reduce((a, b) => a + b, 0);\n  if (!(secTotal > 0)) {\n    throw new Error(\"Develop rulings: secondary edges have zero total length.\");\n  }\n  const perEdge: number[] = secondaryEdges.map((_, k) =>\n    Math.max(1, Math.round((n * secLengths[k]) / secTotal)),\n  );\n  // Correct rounding drift so perEdge sums to n.\n  let perSum = perEdge.reduce((a, b) => a + b, 0);\n  while (perSum !== n) {\n    let bestK = 0;\n    let bestLen = -1;\n    for (let k = 0; k < secondaryEdges.length; k++) {\n      if (secLengths[k] > bestLen) {\n        bestLen = secLengths[k];\n        bestK = k;\n      }\n    }\n    if (perSum < n) {\n      perEdge[bestK] += 1;\n      perSum += 1;\n    } else if (perEdge[bestK] > 1) {\n      perEdge[bestK] -= 1;\n      perSum -= 1;\n    } else {\n      break;\n    }\n  }\n  const samples: T3[] = [];\n  for (let k = 0; k < secondaryEdges.length; k++) {\n    const e = secondaryEdges[k];\n    const cnt = perEdge[k];\n    for (let i = 0; i < cnt; i++) {\n      // Interior sampling so we don't double-count shared vertices; snap pass\n      // below pins one sample per break to the actual vertex.\n      const t = (i + 0.5) / cnt;\n      samples.push(toT3(e.pointAt(t)));\n    }\n  }\n  let cursor = 0;\n  for (let k = 0; k < secondaryEdges.length - 1; k++) {\n    cursor += perEdge[k];\n    const sharedVertex = toT3(secondaryEdges[k].endPoint);\n    const a = cursor - 1;\n    const b = cursor;\n    if (a < 0 || b >= samples.length) continue;\n    const dA = dist3(samples[a], sharedVertex);\n    const dB = dist3(samples[b], sharedVertex);\n    if (dA <= dB) samples[a] = sharedVertex;\n    else samples[b] = sharedVertex;\n  }\n  return samples;\n}\n\n/**\n * Look up the (normalised) surface normal at a 3D point, returning null on\n * any failure (off-surface projection, seam glitch, zero-length normal).\n */\n// eslint-disable-next-line @typescript-eslint/no-explicit-any\nfunction normalAtSafe(face: any, p: T3): T3 | null {\n  try {\n    const nv = face.normalAt(p);\n    const x = nv.x,\n      y = nv.y,\n      z = nv.z;\n    const len = Math.hypot(x, y, z);\n    if (!(len > 0)) return null;\n    return [x / len, y / len, z / len];\n  } catch {\n    return null;\n  }\n}\n\n/**\n * cost[i][j] = 1 − |n_primary[i] · n_secondary[j]|. Range [0, 1]:\n * 0 means the two endpoints lie on parallel (or anti-parallel) tangent\n * planes, 1 means perpendicular. We use |dot| so faces whose normals flip\n * across the surface (closed lofts) don't get scored as max twist.\n */\nfunction buildCostGrid(\n  // eslint-disable-next-line @typescript-eslint/no-explicit-any\n  face: any,\n  primarySamples: T3[],\n  secondarySamples: T3[],\n): number[][] {\n  const n = primarySamples.length;\n  const ns = secondarySamples.length;\n  const primaryNormals = primarySamples.map((p) => normalAtSafe(face, p));\n  const secondaryNormals = secondarySamples.map((p) => normalAtSafe(face, p));\n  const cost: number[][] = new Array(n);\n  for (let i = 0; i < n; i++) {\n    const row: number[] = new Array(ns);\n    const nA = primaryNormals[i];\n    for (let j = 0; j < ns; j++) {\n      const nB = secondaryNormals[j];\n      if (!nA || !nB) {\n        row[j] = Infinity;\n        continue;\n      }\n      const dot = nA[0] * nB[0] + nA[1] * nB[1] + nA[2] * nB[2];\n      row[j] = 1 - Math.abs(dot);\n    }\n    cost[i] = row;\n  }\n  return cost;\n}\n\nfunction logCostStats(\n  pIdx: number,\n  n: number,\n  numSecondaryEdges: number,\n  cost: number[][],\n): void {\n  let min = Infinity;\n  let max = -Infinity;\n  let sum = 0;\n  let count = 0;\n  for (const row of cost) {\n    for (const c of row) {\n      if (!isFinite(c)) continue;\n      if (c < min) min = c;\n      if (c > max) max = c;\n      sum += c;\n      count += 1;\n    }\n  }\n  console.log(\n    `Develop rulings: primary=edge[${pIdx}], n=${n}, secondary=${numSecondaryEdges} edges; ` +\n    `cost min=${min.toExponential(2)} max=${max.toExponential(2)} ` +\n    `mean=${(sum / Math.max(1, count)).toExponential(2)}`,\n  );\n}\n\n/**\n * Non-planarity of the quad (P[i], P[iN], S[jN], S[j]) — perpendicular\n * distance from corner S[j] to the plane of the other three, normalised by\n * mean edge length. Zero for a planar quad; matches the per-quad twist\n * metric used by atomimpl2's developability heatmap.\n */\nfunction quadTwist(\n  P: T3[],\n  S: T3[],\n  i: number,\n  j: number,\n  iN: number,\n  jN: number,\n): number {\n  const A = P[i];\n  const Ap = P[iN];\n  const B = S[j];\n  const Bp = S[jN];\n  const e1x = Ap[0] - A[0],\n    e1y = Ap[1] - A[1],\n    e1z = Ap[2] - A[2];\n  const e2x = Bp[0] - A[0],\n    e2y = Bp[1] - A[1],\n    e2z = Bp[2] - A[2];\n  const e3x = B[0] - A[0],\n    e3y = B[1] - A[1],\n    e3z = B[2] - A[2];\n  const nx = e1y * e2z - e1z * e2y;\n  const ny = e1z * e2x - e1x * e2z;\n  const nz = e1x * e2y - e1y * e2x;\n  const nMag = Math.hypot(nx, ny, nz);\n  const height = nMag > 0 ? Math.abs(nx * e3x + ny * e3y + nz * e3z) / nMag : 0;\n  const avgEdge =\n    0.25 * (dist3(A, Ap) + dist3(Ap, Bp) + dist3(Bp, B) + dist3(B, A));\n  return avgEdge > 0 ? height / avgEdge : 0;\n}\n\n/**\n * Find the minimum-cost monotonic ruling sequence over the (i, j) lattice.\n *\n * Source = (0, 0), sink = (n-1, n-1). From each node (i, j) there are\n * exactly two outgoing edges: (i+1, j) (advance the primary index, keep\n * the secondary fixed) and (i, j+1) (the reverse). Every path therefore\n * takes 2(n-1) steps and emits 2n-1 rulings. Transition weight from\n * (i, j) to (iN, jN) is cost[iN][jN] + quadTwist(...) — the new ruling's\n * normal twist plus the new quad's non-planarity.\n */\nfunction findOptimalRulingPath(\n  cost: number[][],\n  P: T3[],\n  S: T3[],\n): { path: [number, number][]; totalCost: number } {\n  const n = cost.length;\n  const INF = Number.POSITIVE_INFINITY;\n  const dist: number[][] = new Array(n);\n  // prevDir[i][j] === 0 → reached from (i-1, j); === 1 → from (i, j-1).\n  const prevDir: number[][] = new Array(n);\n  for (let i = 0; i < n; i++) {\n    dist[i] = new Array(n).fill(INF);\n    prevDir[i] = new Array(n).fill(-1);\n  }\n  dist[0][0] = cost[0][0];\n\n  // Relax along the (i+j) anti-diagonal so predecessors are always finalised.\n  for (let s = 1; s <= 2 * (n - 1); s++) {\n    const iLo = Math.max(0, s - (n - 1));\n    const iHi = Math.min(n - 1, s);\n    for (let iN = iLo; iN <= iHi; iN++) {\n      const jN = s - iN;\n      const rulingCost = cost[iN][jN];\n      if (!isFinite(rulingCost)) continue;\n      let best = INF;\n      let bestDir = -1;\n      // From (iN-1, jN): advance primary.\n      if (iN > 0 && isFinite(dist[iN - 1][jN])) {\n        const cand =\n          dist[iN - 1][jN] + rulingCost + quadTwist(P, S, iN - 1, jN, iN, jN);\n        if (cand < best) {\n          best = cand;\n          bestDir = 0;\n        }\n      }\n      // From (iN, jN-1): advance secondary.\n      if (jN > 0 && isFinite(dist[iN][jN - 1])) {\n        const cand =\n          dist[iN][jN - 1] + rulingCost + quadTwist(P, S, iN, jN - 1, iN, jN);\n        if (cand < best) {\n          best = cand;\n          bestDir = 1;\n        }\n      }\n      if (best < INF) {\n        dist[iN][jN] = best;\n        prevDir[iN][jN] = bestDir;\n      }\n    }\n  }\n\n  const path: [number, number][] = [];\n  if (isFinite(dist[n - 1][n - 1])) {\n    let ci = n - 1;\n    let cj = n - 1;\n    while (ci >= 0 && cj >= 0) {\n      path.push([ci, cj]);\n      if (ci === 0 && cj === 0) break;\n      const dir = prevDir[ci][cj];\n      if (dir === 0) ci -= 1;\n      else if (dir === 1) cj -= 1;\n      else break;\n    }\n    path.reverse();\n    return { path, totalCost: dist[n - 1][n - 1] };\n  }\n  console.warn(\n    \"Develop rulings: DAG search found no path; falling back to diagonal.\",\n  );\n  for (let k = 0; k < n; k++) path.push([k, k]);\n  return { path, totalCost: INF };\n}\n\n/** Build one Wire-leaf Assembly per (i, j) ruling, skipping degenerates. */\nfunction buildRulingAssemblies(\n  P: T3[],\n  S: T3[],\n  pathIJ: [number, number][],\n): Assembly[] {\n  const out: Assembly[] = [];\n  for (const [i, j] of pathIJ) {\n    const a = P[i];\n    const b = S[j];\n    if (dist3(a, b) <= 0) continue;\n    const edge = replicad.makeLine(a, b);\n    const wire = replicad.assembleWire([edge]);\n    out.push(\n      new Assembly({\n        geometry: wire,\n        color: \"#e07b00\",\n        tags: [\"ruling\"],\n      }),\n    );\n  }\n  return out;\n}\n",
          "compiledCode": "\"use strict\";\n/**\n * Extracts the ruling lines from a ruled surface using the primary/secondary\n * edge framework from Wang et al. (JCISE 2021,\n * https://mewangcl.github.io/pubs/JCISEOptmTrgl.pdf).\n *\n * Input must be an Assembly containing a single replicad.Face. The user picks\n * one edge of the outer wire as the \"primary edge\"; that edge plus all\n * non-adjacent edges (cyclic neighbours of the primary are excluded) drive\n * sampling. We sample `numRulings` points on each side, score every possible\n * (primary[i], secondary[j]) ruling by the angular twist between the surface\n * normals at its two endpoints, then DP a minimum-cost monotonic path over\n * that grid to pick the actual rulings.\n *\n *   primaryEdgeIndex → cyclic index into `face.outerWire().edges`. The two\n *                      neighbouring edges are excluded; remaining edges, in\n *                      original cyclic order, form the secondary.\n */\nfunction run(surface, numRulings = 24, primaryEdgeIndex = 0) {\n    if (!Number.isFinite(numRulings) || numRulings < 2) {\n        throw new Error(\"Develop rulings: numRulings must be an integer ≥ 2 (two rulings \" +\n            \"needed to define a strip).\");\n    }\n    if (!Number.isFinite(primaryEdgeIndex)) {\n        throw new Error(\"Develop rulings: primaryEdgeIndex must be a number.\");\n    }\n    const results = [];\n    // eslint-disable-next-line @typescript-eslint/no-explicit-any\n    surface.onLeafs((leaf) => {\n        // eslint-disable-next-line @typescript-eslint/no-explicit-any\n        if (leaf.geometry instanceof replicad.Drawing) {\n            console.warn(\"Develop rulings: drawings cannot have rulings extracted\");\n            return leaf;\n        }\n        // eslint-disable-next-line @typescript-eslint/no-explicit-any\n        const faces = \n        // eslint-disable-next-line @typescript-eslint/no-explicit-any\n        leaf.geometry instanceof replicad.Face\n            ? // eslint-disable-next-line @typescript-eslint/no-explicit-any\n                [leaf.geometry]\n            : // eslint-disable-next-line @typescript-eslint/no-explicit-any\n                (leaf.geometry.faces ?? []);\n        for (const face of faces) {\n            const { rulings, pIdx, pathIJ, totalCost, costGrid } = ruleFace(face, numRulings, primaryEdgeIndex);\n            results.push(new Assembly({\n                ...leaf,\n                geometry: rulings,\n                tags: [...(leaf.tags ?? []), \"rulings\", \"ruling-primary:\" + pIdx],\n                color: \"blue\",\n                metadata: {\n                    costGrid,\n                    rulingPath: { path: pathIJ, totalCost },\n                },\n            }));\n        }\n        return leaf;\n    });\n    // eslint-disable-next-line @typescript-eslint/no-explicit-any\n    return results;\n}\n/**\n * Extract rulings from a single replicad.Face. Returns the ruling assemblies\n * plus metadata so the caller can build the output Assembly.\n */\nfunction ruleFace(\n// eslint-disable-next-line @typescript-eslint/no-explicit-any\nface, numRulings, primaryEdgeIndex) {\n    const n = Math.max(2, Math.floor(numRulings));\n    const resolvedEdgeIndex = primaryEdgeIndex < 0 ? selectBestRulingEdge(face) : primaryEdgeIndex;\n    const { primary, secondaryEdges, pIdx } = partitionOuterWire(face, resolvedEdgeIndex);\n    const primarySamples = samplePrimary(primary, n);\n    const secondarySamples = sampleSecondary(secondaryEdges, n);\n    const cost = buildCostGrid(face, primarySamples, secondarySamples);\n    logCostStats(pIdx, n, secondaryEdges.length, cost);\n    const { path: pathIJ, totalCost } = findOptimalRulingPath(cost, primarySamples, secondarySamples);\n    console.log(`Develop rulings: path length=${pathIJ.length}, total cost=${totalCost.toExponential(2)}`);\n    const rulings = buildRulingAssemblies(primarySamples, secondarySamples, pathIJ);\n    return {\n        rulings,\n        pIdx,\n        pathIJ,\n        totalCost,\n        costGrid: { n, primaryEdgeIndex: pIdx, cost },\n    };\n}\n/**\n * Probe every outer edge of `face` at a low ruling count and return the\n * index that yields the lowest total ruling cost. Used when primaryEdgeIndex < 0.\n */\nconst RULINGS_PROBE_N = 8;\n// eslint-disable-next-line @typescript-eslint/no-explicit-any\nfunction selectBestRulingEdge(face) {\n    const outerWire = face.clone().outerWire();\n    // eslint-disable-next-line @typescript-eslint/no-explicit-any\n    const allEdges = outerWire.edges ?? [];\n    const m = allEdges.length;\n    let bestIdx = 0;\n    let bestCost = Infinity;\n    for (let k = 0; k < m; k++) {\n        try {\n            const { primary, secondaryEdges } = partitionOuterWire(face, k);\n            const P3 = samplePrimary(primary, RULINGS_PROBE_N);\n            const S3 = sampleSecondary(secondaryEdges, RULINGS_PROBE_N);\n            const cost = buildCostGrid(face, P3, S3);\n            const { totalCost } = findOptimalRulingPath(cost, P3, S3);\n            if (totalCost < bestCost) {\n                bestCost = totalCost;\n                bestIdx = k;\n            }\n        }\n        catch {\n            // edge produced a degenerate partition; skip\n        }\n    }\n    console.log(`Develop rulings auto-select: chose primaryEdgeIndex=${bestIdx} ` +\n        `(cost=${bestCost.toExponential(2)}) from ${m} candidates`);\n    return bestIdx;\n}\nfunction toT3(v) {\n    return [v.x, v.y, v.z];\n}\nfunction dist3(a, b) {\n    return Math.hypot(a[0] - b[0], a[1] - b[1], a[2] - b[2]);\n}\n/**\n * Split the face's outer wire into the user-picked primary edge and the\n * \"secondary\" set (all edges except primary + its two cyclic neighbours).\n * Returns the secondary edges in cyclic order starting two past primary.\n */\nfunction partitionOuterWire(\n// eslint-disable-next-line @typescript-eslint/no-explicit-any\nface, primaryEdgeIndex) {\n    const outerWire = face.clone().outerWire();\n    // eslint-disable-next-line @typescript-eslint/no-explicit-any\n    const allEdges = outerWire.edges ?? [];\n    const m = allEdges.length;\n    const pIdx = ((Math.floor(primaryEdgeIndex) % m) + m) % m;\n    const primary = allEdges[pIdx];\n    const excludedIdx = new Set([pIdx]);\n    if (primary.isClosed) {\n        if (pIdx == 0) {\n            excludedIdx.add(1);\n        }\n        else if (pIdx == allEdges.length - 1) {\n            excludedIdx.add(allEdges.length - 2);\n        }\n        else {\n            console.warn(\"found a closed face with two neighbors..\");\n        }\n    }\n    else {\n        excludedIdx.add((pIdx - 1 + m) % m);\n        excludedIdx.add((pIdx + 1) % m);\n    }\n    // eslint-disable-next-line @typescript-eslint/no-explicit-any\n    const secondaryEdges = [];\n    for (let k = 0; k < m; k++) {\n        const idx = (pIdx + 2 + k) % m;\n        if (!excludedIdx.has(idx))\n            secondaryEdges.push(allEdges[idx]);\n    }\n    if (secondaryEdges.length === 0) {\n        console.warn(\"less than 4 edges total. this may cause bugs later\");\n        secondaryEdges.push(allEdges[(pIdx + 1) % m]);\n    }\n    return { primary, secondaryEdges, pIdx };\n}\n/** Sample the primary edge at n evenly-spaced parametric positions. */\n// eslint-disable-next-line @typescript-eslint/no-explicit-any\nfunction samplePrimary(primary, n) {\n    const out = new Array(n);\n    for (let i = 0; i < n; i++) {\n        const t = n === 1 ? 0 : i / (n - 1);\n        out[i] = toT3(primary.pointAt(t));\n    }\n    return out;\n}\n/**\n * Distribute n samples across the secondary edges proportional to their arc\n * length, then snap the sample nearest each shared vertex to that vertex's\n * 3D position so tangent-break corners survive.\n */\nfunction sampleSecondary(\n// eslint-disable-next-line @typescript-eslint/no-explicit-any\nsecondaryEdges, n) {\n    const secLengths = secondaryEdges.map((e) => e.length);\n    const secTotal = secLengths.reduce((a, b) => a + b, 0);\n    if (!(secTotal > 0)) {\n        throw new Error(\"Develop rulings: secondary edges have zero total length.\");\n    }\n    const perEdge = secondaryEdges.map((_, k) => Math.max(1, Math.round((n * secLengths[k]) / secTotal)));\n    // Correct rounding drift so perEdge sums to n.\n    let perSum = perEdge.reduce((a, b) => a + b, 0);\n    while (perSum !== n) {\n        let bestK = 0;\n        let bestLen = -1;\n        for (let k = 0; k < secondaryEdges.length; k++) {\n            if (secLengths[k] > bestLen) {\n                bestLen = secLengths[k];\n                bestK = k;\n            }\n        }\n        if (perSum < n) {\n            perEdge[bestK] += 1;\n            perSum += 1;\n        }\n        else if (perEdge[bestK] > 1) {\n            perEdge[bestK] -= 1;\n            perSum -= 1;\n        }\n        else {\n            break;\n        }\n    }\n    const samples = [];\n    for (let k = 0; k < secondaryEdges.length; k++) {\n        const e = secondaryEdges[k];\n        const cnt = perEdge[k];\n        for (let i = 0; i < cnt; i++) {\n            // Interior sampling so we don't double-count shared vertices; snap pass\n            // below pins one sample per break to the actual vertex.\n            const t = (i + 0.5) / cnt;\n            samples.push(toT3(e.pointAt(t)));\n        }\n    }\n    let cursor = 0;\n    for (let k = 0; k < secondaryEdges.length - 1; k++) {\n        cursor += perEdge[k];\n        const sharedVertex = toT3(secondaryEdges[k].endPoint);\n        const a = cursor - 1;\n        const b = cursor;\n        if (a < 0 || b >= samples.length)\n            continue;\n        const dA = dist3(samples[a], sharedVertex);\n        const dB = dist3(samples[b], sharedVertex);\n        if (dA <= dB)\n            samples[a] = sharedVertex;\n        else\n            samples[b] = sharedVertex;\n    }\n    return samples;\n}\n/**\n * Look up the (normalised) surface normal at a 3D point, returning null on\n * any failure (off-surface projection, seam glitch, zero-length normal).\n */\n// eslint-disable-next-line @typescript-eslint/no-explicit-any\nfunction normalAtSafe(face, p) {\n    try {\n        const nv = face.normalAt(p);\n        const x = nv.x, y = nv.y, z = nv.z;\n        const len = Math.hypot(x, y, z);\n        if (!(len > 0))\n            return null;\n        return [x / len, y / len, z / len];\n    }\n    catch {\n        return null;\n    }\n}\n/**\n * cost[i][j] = 1 − |n_primary[i] · n_secondary[j]|. Range [0, 1]:\n * 0 means the two endpoints lie on parallel (or anti-parallel) tangent\n * planes, 1 means perpendicular. We use |dot| so faces whose normals flip\n * across the surface (closed lofts) don't get scored as max twist.\n */\nfunction buildCostGrid(\n// eslint-disable-next-line @typescript-eslint/no-explicit-any\nface, primarySamples, secondarySamples) {\n    const n = primarySamples.length;\n    const ns = secondarySamples.length;\n    const primaryNormals = primarySamples.map((p) => normalAtSafe(face, p));\n    const secondaryNormals = secondarySamples.map((p) => normalAtSafe(face, p));\n    const cost = new Array(n);\n    for (let i = 0; i < n; i++) {\n        const row = new Array(ns);\n        const nA = primaryNormals[i];\n        for (let j = 0; j < ns; j++) {\n            const nB = secondaryNormals[j];\n            if (!nA || !nB) {\n                row[j] = Infinity;\n                continue;\n            }\n            const dot = nA[0] * nB[0] + nA[1] * nB[1] + nA[2] * nB[2];\n            row[j] = 1 - Math.abs(dot);\n        }\n        cost[i] = row;\n    }\n    return cost;\n}\nfunction logCostStats(pIdx, n, numSecondaryEdges, cost) {\n    let min = Infinity;\n    let max = -Infinity;\n    let sum = 0;\n    let count = 0;\n    for (const row of cost) {\n        for (const c of row) {\n            if (!isFinite(c))\n                continue;\n            if (c < min)\n                min = c;\n            if (c > max)\n                max = c;\n            sum += c;\n            count += 1;\n        }\n    }\n    console.log(`Develop rulings: primary=edge[${pIdx}], n=${n}, secondary=${numSecondaryEdges} edges; ` +\n        `cost min=${min.toExponential(2)} max=${max.toExponential(2)} ` +\n        `mean=${(sum / Math.max(1, count)).toExponential(2)}`);\n}\n/**\n * Non-planarity of the quad (P[i], P[iN], S[jN], S[j]) — perpendicular\n * distance from corner S[j] to the plane of the other three, normalised by\n * mean edge length. Zero for a planar quad; matches the per-quad twist\n * metric used by atomimpl2's developability heatmap.\n */\nfunction quadTwist(P, S, i, j, iN, jN) {\n    const A = P[i];\n    const Ap = P[iN];\n    const B = S[j];\n    const Bp = S[jN];\n    const e1x = Ap[0] - A[0], e1y = Ap[1] - A[1], e1z = Ap[2] - A[2];\n    const e2x = Bp[0] - A[0], e2y = Bp[1] - A[1], e2z = Bp[2] - A[2];\n    const e3x = B[0] - A[0], e3y = B[1] - A[1], e3z = B[2] - A[2];\n    const nx = e1y * e2z - e1z * e2y;\n    const ny = e1z * e2x - e1x * e2z;\n    const nz = e1x * e2y - e1y * e2x;\n    const nMag = Math.hypot(nx, ny, nz);\n    const height = nMag > 0 ? Math.abs(nx * e3x + ny * e3y + nz * e3z) / nMag : 0;\n    const avgEdge = 0.25 * (dist3(A, Ap) + dist3(Ap, Bp) + dist3(Bp, B) + dist3(B, A));\n    return avgEdge > 0 ? height / avgEdge : 0;\n}\n/**\n * Find the minimum-cost monotonic ruling sequence over the (i, j) lattice.\n *\n * Source = (0, 0), sink = (n-1, n-1). From each node (i, j) there are\n * exactly two outgoing edges: (i+1, j) (advance the primary index, keep\n * the secondary fixed) and (i, j+1) (the reverse). Every path therefore\n * takes 2(n-1) steps and emits 2n-1 rulings. Transition weight from\n * (i, j) to (iN, jN) is cost[iN][jN] + quadTwist(...) — the new ruling's\n * normal twist plus the new quad's non-planarity.\n */\nfunction findOptimalRulingPath(cost, P, S) {\n    const n = cost.length;\n    const INF = Number.POSITIVE_INFINITY;\n    const dist = new Array(n);\n    // prevDir[i][j] === 0 → reached from (i-1, j); === 1 → from (i, j-1).\n    const prevDir = new Array(n);\n    for (let i = 0; i < n; i++) {\n        dist[i] = new Array(n).fill(INF);\n        prevDir[i] = new Array(n).fill(-1);\n    }\n    dist[0][0] = cost[0][0];\n    // Relax along the (i+j) anti-diagonal so predecessors are always finalised.\n    for (let s = 1; s <= 2 * (n - 1); s++) {\n        const iLo = Math.max(0, s - (n - 1));\n        const iHi = Math.min(n - 1, s);\n        for (let iN = iLo; iN <= iHi; iN++) {\n            const jN = s - iN;\n            const rulingCost = cost[iN][jN];\n            if (!isFinite(rulingCost))\n                continue;\n            let best = INF;\n            let bestDir = -1;\n            // From (iN-1, jN): advance primary.\n            if (iN > 0 && isFinite(dist[iN - 1][jN])) {\n                const cand = dist[iN - 1][jN] + rulingCost + quadTwist(P, S, iN - 1, jN, iN, jN);\n                if (cand < best) {\n                    best = cand;\n                    bestDir = 0;\n                }\n            }\n            // From (iN, jN-1): advance secondary.\n            if (jN > 0 && isFinite(dist[iN][jN - 1])) {\n                const cand = dist[iN][jN - 1] + rulingCost + quadTwist(P, S, iN, jN - 1, iN, jN);\n                if (cand < best) {\n                    best = cand;\n                    bestDir = 1;\n                }\n            }\n            if (best < INF) {\n                dist[iN][jN] = best;\n                prevDir[iN][jN] = bestDir;\n            }\n        }\n    }\n    const path = [];\n    if (isFinite(dist[n - 1][n - 1])) {\n        let ci = n - 1;\n        let cj = n - 1;\n        while (ci >= 0 && cj >= 0) {\n            path.push([ci, cj]);\n            if (ci === 0 && cj === 0)\n                break;\n            const dir = prevDir[ci][cj];\n            if (dir === 0)\n                ci -= 1;\n            else if (dir === 1)\n                cj -= 1;\n            else\n                break;\n        }\n        path.reverse();\n        return { path, totalCost: dist[n - 1][n - 1] };\n    }\n    console.warn(\"Develop rulings: DAG search found no path; falling back to diagonal.\");\n    for (let k = 0; k < n; k++)\n        path.push([k, k]);\n    return { path, totalCost: INF };\n}\n/** Build one Wire-leaf Assembly per (i, j) ruling, skipping degenerates. */\nfunction buildRulingAssemblies(P, S, pathIJ) {\n    const out = [];\n    for (const [i, j] of pathIJ) {\n        const a = P[i];\n        const b = S[j];\n        if (dist3(a, b) <= 0)\n            continue;\n        const edge = replicad.makeLine(a, b);\n        const wire = replicad.assembleWire([edge]);\n        out.push(new Assembly({\n            geometry: wire,\n            color: \"#e07b00\",\n            tags: [\"ruling\"],\n        }));\n    }\n    return out;\n}\n"
        },
