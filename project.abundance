            {
              "atomType": "GitHubMolecule",
              "x": 0.607421875,
              "y": 0.15416666666666665,
              "uniqueID": "id-76361",
              "name": "util.SelectEdgeLoop",
              "ioValues": [
                {
                  "name": "shape",
                  "ioValue": "__GEOMETRY_INPUT__"
                },
