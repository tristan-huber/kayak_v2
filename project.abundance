              "uniqueID": "id-27857",
              "ioValues": [
                {
                  "name": "shape",
                  "ioValue": "__GEOMETRY_INPUT__"
                },
                {
                  "name": "index",
                  "ioValue": 0
                }
              ],
              "interpreterVersion": 1,
              "code": "function run(\n  shape: Assembly,\n  index: number = 0) {\n  let result: replicad.Wire;\n  let total = 0;\n  shape.onLeafs((leaf) => {\n    let faces: replicad.Face[] = []\n    if (leaf.geometry instanceof replicad.Drawing) {\n      const sketches = leaf.geometry.sketchOnPlane(leaf.plane)\n      if (sketches instanceof replicad.Sketches) {\n        const t = sketches.faces()\n        faces = t instanceof replicad.Face ? [t] : t.faces\n      } else {\n        faces = [sketches.face()]\n      }\n    } else {\n      faces = leaf.geometry.faces\n    }\n    const wires = faces.map((face) => {\n      return [face.clone().outerWire(), ...face.innerWires()]\n    }).flat()\n    total += wires.length\n    if (index >= 0 && index < wires.length) {\n      result = wires[index]\n    }\n    index -= wires.length\n    return leaf;\n  })\n  console.log(result)\n  if (result === undefined) {\n    throw new Error(\"Index out of bounds. Only \" + total + \" eligible wires\")\n  }\n  return result;\n}\n",
              "compiledCode": "\"use strict\";\nfunction run(shape, index = 0) {\n    let result;\n    let total = 0;\n    shape.onLeafs((leaf) => {\n        let faces = [];\n        if (leaf.geometry instanceof replicad.Drawing) {\n            const sketches = leaf.geometry.sketchOnPlane(leaf.plane);\n            if (sketches instanceof replicad.Sketches) {\n                const t = sketches.faces();\n                faces = t instanceof replicad.Face ? [t] : t.faces;\n            }\n            else {\n                faces = [sketches.face()];\n            }\n        }\n        else {\n            faces = leaf.geometry.faces;\n        }\n        const wires = faces.map((face) => {\n            return [face.clone().outerWire(), ...face.innerWires()];\n        }).flat();\n        total += wires.length;\n        if (index >= 0 && index < wires.length) {\n            result = wires[index];\n        }\n        index -= wires.length;\n        return leaf;\n    });\n    console.log(result);\n    if (result === undefined) {\n        throw new Error(\"Index out of bounds. Only \" + total + \" eligible wires\");\n    }\n    return result;\n}\n"
            },
