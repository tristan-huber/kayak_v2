          "interpreterVersion": 1,
          "code": "// bindPointToNearestPlane\nfunction run(points: Assembly, planes: Assembly) {\n  const rawPlanes: replicad.Plane[] = []\n  planes.onLeafs((leaf) => {\n    rawPlanes.push(leaf.plane)\n    return leaf;\n  })\n\n  return points.onLeafs((leaf) => {\n    if (leaf.isPoint()) {\n      const point: replicad.Vertex = leaf.geometry;\n      const dists = rawPlanes.map((plane) => {\n        return projectVertexOntoPlane(plane, point)\n      })\n      dists.sort((a, b) => a[0] - b[0])\n      console.log(dists.map((i) => i[0]))\n      leaf.geometry = replicad.makeVertex(dists[0][1])\n      leaf.plane = dists[0][2]\n      return leaf;\n    }\n  })\n}\n\nfunction projectVertexOntoPlane(\n  plane: replicad.Plane,\n  vertex: replicad.Vertex,\n): [number, replicad.Vector, replicad.Plane] {\n  const asVec = new replicad.Vector(vertex.asTuple())\n  const res = asVec.projectToPlane(plane);\n  return [res.add(asVec.multiply(-1)).Length, res, plane]\n}\n\nfunction projectPointOntoPlane(plane: replicad.Plane, point: replicad.Vertex) {\n  const origin = [plane.origin.x, plane.origin.y, plane.origin.z];\n  const normal = [plane.zDir.x, plane.zDir.y, plane.zDir.z];\n\n  const distance =\n    ( - origin[0]) * normal[0] +\n    (point[1] - origin[1]) * normal[1] +\n    (point[2] - origin[2]) * normal[2];\n\n  return point.map((coordinate, i) => coordinate - distance * normal[i]);\n}\n",
          "compiledCode": "\"use strict\";\n// bindPointToNearestPlane\nfunction run(points, planes) {\n    const rawPlanes = [];\n    planes.onLeafs((leaf) => {\n        rawPlanes.push(leaf.plane);\n        return leaf;\n    });\n    return points.onLeafs((leaf) => {\n        if (leaf.isPoint()) {\n            const point = leaf.geometry;\n            const dists = rawPlanes.map((plane) => {\n                return projectVertexOntoPlane(plane, point);\n            });\n            dists.sort((a, b) => a[0] - b[0]);\n            console.log(dists.map((i) => i[0]));\n            leaf.geometry = replicad.makeVertex(dists[0][1]);\n            leaf.plane = dists[0][2];\n            return leaf;\n        }\n    });\n}\nfunction projectVertexOntoPlane(plane, vertex) {\n    const asVec = new replicad.Vector(vertex.asTuple());\n    const res = asVec.projectToPlane(plane);\n    return [res.add(asVec.multiply(-1)).Length, res, plane];\n}\nfunction projectPointOntoPlane(plane, point) {\n    const origin = [plane.origin.x, plane.origin.y, plane.origin.z];\n    const normal = [plane.zDir.x, plane.zDir.y, plane.zDir.z];\n    const distance = (-origin[0]) * normal[0] +\n        (point[1] - origin[1]) * normal[1] +\n        (point[2] - origin[2]) * normal[2];\n    return point.map((coordinate, i) => coordinate - distance * normal[i]);\n}\n"
