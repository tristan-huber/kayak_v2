          "uniqueID": "id-26939",
          "name": "Scale",
          "ioValues": [
            {
              "name": "Scale Factor",
              "ioValue": 0.93
            }
          ],
          "topLevel": false,
          "allAtoms": [
            {
              "atomType": "Output",
