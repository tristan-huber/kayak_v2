              "uniqueID": "id-43353",
              "ioValues": [
                {
                  "name": "primaryGuideWire",
                  "ioValue": "__GEOMETRY_INPUT__"
                },
                {
                  "name": "secondaryGuideWire",
                  "ioValue": "__GEOMETRY_INPUT__"
