          "name": "select.adjascentFaces",
          "ioValues": [
            {
              "name": "assembly",
              "ioValue": "__GEOMETRY_INPUT__"
            }
          ],
          "topLevel": false,
          "allAtoms": [
            {
              "atomType": "Output",
              "x": 0.98,
              "y": 0.5,
              "uniqueID": "id-87512",
              "ioValues": [
                {
                  "name": "number or geometry",
