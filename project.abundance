              "interpreterVersion": 1,
              "code": "function run(face: Assembly) {\n  return face.onLeafs((leaf) => {\n    if (leaf.geometry instanceof replicad.Face) {\n      leaf.geometry.outerWire().edges.forEach((edge) => {\n        console.log(edge.geomType, \" line dist: \", diffFromLine(edge))\n      })\n    } else if (!(leaf.geometry instanceof replicad.Drawing) && replicad.isShape3D(leaf.geometry)) {\n      leaf.geometry.faces.forEach((face) => {\n        face.outerWire().edges.forEach((edge) => {\n          console.log(edge.geomType, \" line dist:  \", diffFromLine(edge))\n        })\n      })\n    }\n    return leaf;\n  })\n}\n\n// Pre-compute once for the fixed line (point1 → point2)\nfunction makeLineDistancer(point1: replicad.Vector, point2: replicad.Vector) {\n  const dir = point2.sub(point1);\n  const lenSq = dir.dot(dir);\n  if (lenSq === 0) throw new Error(\"point1 and point2 are coincident\");\n  const len = Math.sqrt(lenSq);\n  return {\n    // Returns perpendicular distance from point3 to the line\n    distTo(point3: replicad.Vector): number {\n      const ap = point3.sub(point1);\n      // Cross product magnitude = |ap × dir| / |dir|\n      const cx = ap.y * dir.z - ap.z * dir.y;\n      const cy = ap.z * dir.x - ap.x * dir.z;\n      const cz = ap.x * dir.y - ap.y * dir.x;\n      return Math.sqrt(cx * cx + cy * cy + cz * cz) / len;\n    },\n  };\n}\n\n\nfunction diffFromLine(curve: replicad.Edge): number {\n  const liner = makeLineDistancer(curve.startPoint, curve.endPoint)\n  let total = 0;\n  const samples = 100\n  for (let i = 0; i < samples; i++) {\n    total += liner.distTo(curve.pointAt(i / samples))\n  }\n  return total;\n}",
              "compiledCode": "\"use strict\";\nfunction run(face) {\n    return face.onLeafs((leaf) => {\n        if (leaf.geometry instanceof replicad.Face) {\n            leaf.geometry.outerWire().edges.forEach((edge) => {\n                console.log(edge.geomType, \" line dist: \", diffFromLine(edge));\n            });\n        }\n        else if (!(leaf.geometry instanceof replicad.Drawing) && replicad.isShape3D(leaf.geometry)) {\n            leaf.geometry.faces.forEach((face) => {\n                face.outerWire().edges.forEach((edge) => {\n                    console.log(edge.geomType, \" line dist:  \", diffFromLine(edge));\n                });\n            });\n        }\n        return leaf;\n    });\n}\n// Pre-compute once for the fixed line (point1 → point2)\nfunction makeLineDistancer(point1, point2) {\n    const dir = point2.sub(point1);\n    const lenSq = dir.dot(dir);\n    if (lenSq === 0)\n        throw new Error(\"point1 and point2 are coincident\");\n    const len = Math.sqrt(lenSq);\n    return {\n        // Returns perpendicular distance from point3 to the line\n        distTo(point3) {\n            const ap = point3.sub(point1);\n            // Cross product magnitude = |ap × dir| / |dir|\n            const cx = ap.y * dir.z - ap.z * dir.y;\n            const cy = ap.z * dir.x - ap.x * dir.z;\n            const cz = ap.x * dir.y - ap.y * dir.x;\n            return Math.sqrt(cx * cx + cy * cy + cz * cz) / len;\n        },\n    };\n}\nfunction diffFromLine(curve) {\n    const liner = makeLineDistancer(curve.startPoint, curve.endPoint);\n    let total = 0;\n    const samples = 100;\n    for (let i = 0; i < samples; i++) {\n        total += liner.distTo(curve.pointAt(i / samples));\n    }\n    return total;\n}\n"
