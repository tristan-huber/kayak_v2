                  ]
                },
                {
                  "atomType": "Code",
                  "x": 0.529296875,
                  "y": 0.7053571428571429,
                  "uniqueID": "id-17207",
                  "ioValues": [
                    {
                      "name": "surface",
                      "ioValue": "__GEOMETRY_INPUT__"
                    },
                    {
                      "name": "numRulings",
                      "ioValue": 24
                    },
                    {
                      "name": "rulingAxis",
                      "ioValue": "auto",
                      "currentEquation": "auto"
                    },
                    {
                      "name": "seamAtStart",
                      "ioValue": true
                    },
                    {
