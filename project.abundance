          "interpreterVersion": 1,
          "code": "// face.normal\nfunction run(face: Assembly, u: number = 0.5, v: number = 0.5) {\n  let faces = face.getSelectedFaces().filter((a) => a != undefined && a != null);\n  if (faces.length == 0) {\n    face.onLeafs((leaf) => {\n      if (leaf.geometry instanceof replicad.Face) {\n        faces.push(leaf.geometry)\n      }\n      return leaf;\n    })\n  }\n\n  if (faces.length != 1) {\n    throw new Error(\"needs exactly one face or one selected face as input. Got \" + faces.length)\n  }\n  console.log(faces)\n  return faces[0].normalAt([u,v]).normalize().toTuple()\n}",
          "compiledCode": "\"use strict\";\n// face.normal\nfunction run(face, u = 0.5, v = 0.5) {\n    let faces = face.getSelectedFaces().filter((a) => a != undefined && a != null);\n    if (faces.length == 0) {\n        face.onLeafs((leaf) => {\n            if (leaf.geometry instanceof replicad.Face) {\n                faces.push(leaf.geometry);\n            }\n            return leaf;\n        });\n    }\n    if (faces.length != 1) {\n        throw new Error(\"needs exactly one face or one selected face as input. Got \" + faces.length);\n    }\n    console.log(faces);\n    return faces[0].normalAt([u, v]).normalize().toTuple();\n}\n"
        },
        {
          "atomType": "Code",
          "x": 0.71484375,
          "y": 0.7771428571428571,
          "uniqueID": "id-83585",
          "ioValues": [
