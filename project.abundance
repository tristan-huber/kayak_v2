            {
              "atomType": "Code",
              "x": 0.5026041666666666,
              "y": 0.5028571428571429,
              "uniqueID": "id-87608",
              "ioValues": [
                {
                  "name": "face",
                  "ioValue": "__GEOMETRY_INPUT__"
                },
                {
                  "name": "u",
