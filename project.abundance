              ],
              "interpreterVersion": 1,
              "code": "/**\n * Visualises the twist (non-planarity) of a ruled surface as a colour\n * heatmap baked into the face's mesh, using the same DP-based ruling\n * framework as atomimpl2.ts.\n *\n * Each ruling in the optimal path is assigned the normal-twist cost\n * cost[i][j] from the DP grid. Mesh vertices are coloured by the cost of\n * their nearest ruling centroid in 3D (white = low twist, red = high).\n *\n *   primaryEdgeIndex → cyclic index into face.outerWire().edges; same\n *                      convention as atomimpl2.ts. Pass a negative number\n *                      to auto-select the lowest-cost primary edge.\n */\n// eslint-disable-next-line @typescript-eslint/no-unused-vars\nfunction run(\n  surface: Assembly,\n  numRulings: number = 24,\n  primaryEdgeIndex: number = 0,\n): Assembly {\n  if (!Number.isFinite(numRulings) || numRulings < 2) {\n    throw new Error(\"Twist heatmap: numRulings must be an integer ≥ 2.\");\n  }\n  if (!Number.isFinite(primaryEdgeIndex)) {\n    throw new Error(\"Twist heatmap: primaryEdgeIndex must be a number.\");\n  }\n  const results: Assembly[] = [];\n  // eslint-disable-next-line @typescript-eslint/no-explicit-any\n  (surface as any).onLeafs((leaf: Assembly) => {\n    // eslint-disable-next-line @typescript-eslint/no-explicit-any\n    if ((leaf.geometry as any) instanceof replicad.Drawing) {\n      console.warn(\"Twist heatmap: drawings cannot have a heatmap computed\");\n      return leaf;\n    }\n    // eslint-disable-next-line @typescript-eslint/no-explicit-any\n    const faces: any[] =\n      // eslint-disable-next-line @typescript-eslint/no-explicit-any\n      (leaf.geometry as any) instanceof replicad.Face\n        ? // eslint-disable-next-line @typescript-eslint/no-explicit-any\n        [leaf.geometry as any]\n        : // eslint-disable-next-line @typescript-eslint/no-explicit-any\n        ((leaf.geometry as any).faces ?? []);\n    for (const face of faces) {\n      results.push(\n        buildHeatmapForFace(face, leaf, numRulings, primaryEdgeIndex),\n      );\n    }\n    return leaf;\n  });\n\n  // eslint-disable-next-line @typescript-eslint/no-explicit-any\n  return new Assembly({geometry: results});\n}\n\n/**\n * Probe every outer edge at AUTO_PROBE_N rulings and return the index with\n * the lowest total ruling cost. Named distinctly from atomimpl2's\n * selectBestPrimaryEdge to avoid the shared global-scope collision.\n */\nconst HEATMAP_PROBE_N = 8;\n// eslint-disable-next-line @typescript-eslint/no-explicit-any\nfunction selectBestHeatmapEdge(face: any): number {\n  // eslint-disable-next-line @typescript-eslint/no-explicit-any\n  const allEdges: any[] = face.clone().outerWire().edges ?? [];\n  const m = allEdges.length;\n  let bestIdx = 0;\n  let bestCost = Infinity;\n  for (let k = 0; k < m; k++) {\n    try {\n      // partitionOuterWire / samplePrimary / sampleSecondary / buildCostGrid /\n      // findOptimalRulingPath are all in global scope from atomimpl2.ts.\n      // eslint-disable-next-line @typescript-eslint/no-explicit-any\n      const { primary, secondaryEdges } = (partitionOuterWire as any)(face, k);\n      // eslint-disable-next-line @typescript-eslint/no-explicit-any\n      const P3 = (samplePrimary as any)(primary, HEATMAP_PROBE_N);\n      // eslint-disable-next-line @typescript-eslint/no-explicit-any\n      const S3 = (sampleSecondary as any)(secondaryEdges, HEATMAP_PROBE_N);\n      // eslint-disable-next-line @typescript-eslint/no-explicit-any\n      const cost = (buildCostGrid as any)(face, P3, S3);\n      // eslint-disable-next-line @typescript-eslint/no-explicit-any\n      const { totalCost } = (findOptimalRulingPath as any)(cost, P3, S3);\n      if (totalCost < bestCost) {\n        bestCost = totalCost;\n        bestIdx = k;\n      }\n    } catch {\n      // degenerate partition; skip\n    }\n  }\n  console.log(\n    `Twist heatmap auto-select: chose primaryEdgeIndex=${bestIdx} ` +\n    `(cost=${bestCost.toExponential(2)}) from ${m} candidates`,\n  );\n  return bestIdx;\n}\n\n/**\n * Run the DP ruling algorithm on a single Face and return an Assembly whose\n * geometry is the original face with a colour heatmap baked into its mesh.\n */\nfunction buildHeatmapForFace(\n  // eslint-disable-next-line @typescript-eslint/no-explicit-any\n  face: any,\n  sourceLeaf: Assembly,\n  numRulings: number,\n  primaryEdgeIndex: number,\n): Assembly {\n  const n = Math.max(2, Math.floor(numRulings));\n  const resolvedEdgeIndex =\n    primaryEdgeIndex < 0 ? selectBestHeatmapEdge(face) : primaryEdgeIndex;\n\n  // eslint-disable-next-line @typescript-eslint/no-explicit-any\n  const { primary, secondaryEdges, pIdx } = (partitionOuterWire as any)(\n    face,\n    resolvedEdgeIndex,\n  );\n  // eslint-disable-next-line @typescript-eslint/no-explicit-any\n  const P3: [number, number, number][] = (samplePrimary as any)(primary, n);\n  // eslint-disable-next-line @typescript-eslint/no-explicit-any\n  const S3: [number, number, number][] = (sampleSecondary as any)(\n    secondaryEdges,\n    n,\n  );\n  // eslint-disable-next-line @typescript-eslint/no-explicit-any\n  const cost: number[][] = (buildCostGrid as any)(face, P3, S3);\n  // eslint-disable-next-line @typescript-eslint/no-explicit-any\n  const { path, totalCost } = (findOptimalRulingPath as any)(cost, P3, S3);\n\n  console.log(\n    `Twist heatmap: primary=edge[${pIdx}], n=${n}, ` +\n    `path=${path.length} rulings, total cost=${totalCost.toExponential(2)}`,\n  );\n\n  // Per-ruling cost and 3D centroid for mesh vertex assignment.\n  const rulingCosts: number[] = path.map(\n    ([i, j]: [number, number]) => cost[i][j],\n  );\n  const rulingCentroids: [number, number, number][] = path.map(\n    ([i, j]: [number, number]) =>\n      [\n        (P3[i][0] + S3[j][0]) / 2,\n        (P3[i][1] + S3[j][1]) / 2,\n        (P3[i][2] + S3[j][2]) / 2,\n      ] as [number, number, number],\n  );\n\n  return new Assembly({\n    ...sourceLeaf,\n    geometry: face,\n    tags: [\n      ...(sourceLeaf.tags ?? []),\n      \"heatmap:twist\",\n      \"ruling-primary:\" + pIdx,\n    ],\n    metadata: {\n      meshOverride: buildHeatmapMeshOverride(\n        face,\n        rulingCosts,\n        rulingCentroids,\n      ),\n    },\n  });\n}\n// ─── meshOverride baking ──────────────────────────────────────────────────\n//\n// Colour the face's own OCCT tessellation by ruling cost. Every mesh vertex\n// is assigned the cost of its nearest ruling centroid in 3D, then painted\n// with a white→red gradient (white = low twist / near-developable,\n// red = high twist). Reusing the face's existing mesh avoids re-tessellation.\n\nfunction buildHeatmapMeshOverride(\n  // eslint-disable-next-line @typescript-eslint/no-explicit-any\n  face: any,\n  rulingCosts: number[],\n  rulingCentroids: [number, number, number][],\n) {\n  const faces = face.mesh({ tolerance: 0.1, angularTolerance: 0.5 });\n  const edges = face.meshEdges({ tolerance: 0.1, angularTolerance: 0.5 });\n\n  const [r0, g0, b0] = hexToRgb(\"#ffffff\");\n  const [r1, g1, b1] = hexToRgb(\"#ff0000\");\n\n  // Normalise so the full dynamic range of this face fills the colormap.\n  let costMin = Infinity;\n  let costMax = -Infinity;\n  for (const c of rulingCosts) {\n    if (c < costMin) costMin = c;\n    if (c > costMax) costMax = c;\n  }\n  const costSpan = costMax - costMin;\n\n  const numVerts = faces.vertices.length / 3;\n  const vertexColors: number[] = new Array(numVerts * 3);\n  for (let v = 0; v < numVerts; v++) {\n    const px = faces.vertices[v * 3];\n    const py = faces.vertices[v * 3 + 1];\n    const pz = faces.vertices[v * 3 + 2];\n\n    // Find nearest ruling centroid in 3D.\n    let nearestIdx = 0;\n    let nearestDist = Infinity;\n    for (let k = 0; k < rulingCentroids.length; k++) {\n      const c = rulingCentroids[k];\n      const d = Math.hypot(px - c[0], py - c[1], pz - c[2]);\n      if (d < nearestDist) {\n        nearestDist = d;\n        nearestIdx = k;\n      }\n    }\n\n    let s = costSpan > 0 ? (rulingCosts[nearestIdx] - costMin) / costSpan : 0;\n    if (s < 0) s = 0;\n    else if (s > 1) s = 1;\n    vertexColors[v * 3] = r0 + (r1 - r0) * s;\n    vertexColors[v * 3 + 1] = g0 + (g1 - g0) * s;\n    vertexColors[v * 3 + 2] = b0 + (b1 - b0) * s;\n  }\n\n  return {\n    faces,\n    edges,\n    // Plain array so metadata.meshOverride survives the JSON round-trip.\n    vertexColors,\n  };\n}\n\nfunction hexToRgb(hex: string): [number, number, number] {\n  const h = hex.replace(\"#\", \"\");\n  return [\n    parseInt(h.slice(0, 2), 16) / 255,\n    parseInt(h.slice(2, 4), 16) / 255,\n    parseInt(h.slice(4, 6), 16) / 255,\n  ];\n}\n\n// ─── Shared helpers (mirror atomimpl.ts; sandboxed files can't import) ───\n\ntype T3 = [number, number, number];\ntype T2 = [number, number];\n\nfunction toT3(v: { x: number; y: number; z: number }): T3 {\n  return [v.x, v.y, v.z];\n}\n\nfunction dist3(a: T3, b: T3): number {\n  return Math.hypot(a[0] - b[0], a[1] - b[1], a[2] - b[2]);\n}\n\nfunction partitionOuterWire(\n  // eslint-disable-next-line @typescript-eslint/no-explicit-any\n  face: any,\n  primaryEdgeIndex: number,\n  // eslint-disable-next-line @typescript-eslint/no-explicit-any\n): { primary: any; secondaryEdges: any[]; pIdx: number } {\n  const outerWire = face.clone().outerWire();\n  // eslint-disable-next-line @typescript-eslint/no-explicit-any\n  const allEdges: any[] = outerWire.edges ?? [];\n  const m = allEdges.length;\n  const pIdx = ((Math.floor(primaryEdgeIndex) % m) + m) % m;\n  const primary = allEdges[pIdx];\n\n  const excludedIdx = new Set([pIdx]);\n  if (primary.isClosed) {\n    if (pIdx == 0) {\n      excludedIdx.add(1);\n    } else if (pIdx == allEdges.length - 1) {\n      excludedIdx.add(allEdges.length - 2);\n    } else {\n      console.warn(\"found a closed face with two neighbors..\");\n    }\n  } else {\n    excludedIdx.add((pIdx - 1 + m) % m);\n    excludedIdx.add((pIdx + 1) % m);\n  }\n  // eslint-disable-next-line @typescript-eslint/no-explicit-any\n  const secondaryEdges: any[] = [];\n  for (let k = 0; k < m; k++) {\n    const idx = (pIdx + 2 + k) % m;\n    if (!excludedIdx.has(idx)) secondaryEdges.push(allEdges[idx]);\n  }\n  if (secondaryEdges.length === 0) {\n    console.warn(\"less than 4 edges total. this may cause bugs later\");\n    secondaryEdges.push(allEdges[(pIdx + 1) % m]);\n  }\n  return { primary, secondaryEdges, pIdx };\n}\n\n// eslint-disable-next-line @typescript-eslint/no-explicit-any\nfunction samplePrimary(primary: any, n: number): T3[] {\n  const out: T3[] = new Array(n);\n  for (let i = 0; i < n; i++) {\n    const t = n === 1 ? 0 : i / (n - 1);\n    out[i] = toT3(primary.pointAt(t));\n  }\n  return out;\n}\n\nfunction sampleSecondary(\n  // eslint-disable-next-line @typescript-eslint/no-explicit-any\n  secondaryEdges: any[],\n  n: number,\n): T3[] {\n  const secLengths = secondaryEdges.map((e) => e.length);\n  const secTotal = secLengths.reduce((a, b) => a + b, 0);\n  if (!(secTotal > 0)) {\n    throw new Error(\"Unroll surface: secondary edges have zero total length.\");\n  }\n  const perEdge: number[] = secondaryEdges.map((_, k) =>\n    Math.max(1, Math.round((n * secLengths[k]) / secTotal)),\n  );\n  let perSum = perEdge.reduce((a, b) => a + b, 0);\n  while (perSum !== n) {\n    let bestK = 0;\n    let bestLen = -1;\n    for (let k = 0; k < secondaryEdges.length; k++) {\n      if (secLengths[k] > bestLen) {\n        bestLen = secLengths[k];\n        bestK = k;\n      }\n    }\n    if (perSum < n) {\n      perEdge[bestK] += 1;\n      perSum += 1;\n    } else if (perEdge[bestK] > 1) {\n      perEdge[bestK] -= 1;\n      perSum -= 1;\n    } else {\n      break;\n    }\n  }\n  const samples: T3[] = [];\n  for (let k = 0; k < secondaryEdges.length; k++) {\n    const e = secondaryEdges[k];\n    const cnt = perEdge[k];\n    for (let i = 0; i < cnt; i++) {\n      const t = (i + 0.5) / cnt;\n      samples.push(toT3(e.pointAt(t)));\n    }\n  }\n  let cursor = 0;\n  for (let k = 0; k < secondaryEdges.length - 1; k++) {\n    cursor += perEdge[k];\n    const sharedVertex = toT3(secondaryEdges[k].endPoint);\n    const a = cursor - 1;\n    const b = cursor;\n    if (a < 0 || b >= samples.length) continue;\n    const dA = dist3(samples[a], sharedVertex);\n    const dB = dist3(samples[b], sharedVertex);\n    if (dA <= dB) samples[a] = sharedVertex;\n    else samples[b] = sharedVertex;\n  }\n  return samples;\n}\n\n// eslint-disable-next-line @typescript-eslint/no-explicit-any\nfunction normalAtSafe(face: any, p: T3): T3 | null {\n  try {\n    const nv = face.normalAt(p);\n    const x = nv.x,\n      y = nv.y,\n      z = nv.z;\n    const len = Math.hypot(x, y, z);\n    if (!(len > 0)) return null;\n    return [x / len, y / len, z / len];\n  } catch {\n    return null;\n  }\n}\n\nfunction buildCostGrid(\n  // eslint-disable-next-line @typescript-eslint/no-explicit-any\n  face: any,\n  primarySamples: T3[],\n  secondarySamples: T3[],\n): number[][] {\n  const n = primarySamples.length;\n  const ns = secondarySamples.length;\n  const primaryNormals = primarySamples.map((p) => normalAtSafe(face, p));\n  const secondaryNormals = secondarySamples.map((p) => normalAtSafe(face, p));\n  const cost: number[][] = new Array(n);\n  for (let i = 0; i < n; i++) {\n    const row: number[] = new Array(ns);\n    const nA = primaryNormals[i];\n    for (let j = 0; j < ns; j++) {\n      const nB = secondaryNormals[j];\n      if (!nA || !nB) {\n        row[j] = Infinity;\n        continue;\n      }\n      const dot = nA[0] * nB[0] + nA[1] * nB[1] + nA[2] * nB[2];\n      row[j] = 1 - Math.abs(dot);\n    }\n    cost[i] = row;\n  }\n  return cost;\n}\n\nfunction quadTwist(\n  P: T3[],\n  S: T3[],\n  i: number,\n  j: number,\n  iN: number,\n  jN: number,\n): number {\n  const A = P[i];\n  const Ap = P[iN];\n  const B = S[j];\n  const Bp = S[jN];\n  const e1x = Ap[0] - A[0],\n    e1y = Ap[1] - A[1],\n    e1z = Ap[2] - A[2];\n  const e2x = Bp[0] - A[0],\n    e2y = Bp[1] - A[1],\n    e2z = Bp[2] - A[2];\n  const e3x = B[0] - A[0],\n    e3y = B[1] - A[1],\n    e3z = B[2] - A[2];\n  const nx = e1y * e2z - e1z * e2y;\n  const ny = e1z * e2x - e1x * e2z;\n  const nz = e1x * e2y - e1y * e2x;\n  const nMag = Math.hypot(nx, ny, nz);\n  const height = nMag > 0 ? Math.abs(nx * e3x + ny * e3y + nz * e3z) / nMag : 0;\n  const avgEdge =\n    0.25 * (dist3(A, Ap) + dist3(Ap, Bp) + dist3(Bp, B) + dist3(B, A));\n  return avgEdge > 0 ? height / avgEdge : 0;\n}\n\n/**\n * 2-neighbour anti-diagonal DP: from (i, j) you may only advance to\n * (i+1, j) or (i, j+1). Every path has 2(n-1) steps and emits 2n-1 rulings.\n * Identical to the implementation in atomimpl.ts.\n */\nfunction findOptimalRulingPath(\n  cost: number[][],\n  P: T3[],\n  S: T3[],\n): { path: [number, number][]; totalCost: number } {\n  const n = cost.length;\n  const INF = Number.POSITIVE_INFINITY;\n  const dist: number[][] = new Array(n);\n  const prevDir: number[][] = new Array(n);\n  for (let i = 0; i < n; i++) {\n    dist[i] = new Array(n).fill(INF);\n    prevDir[i] = new Array(n).fill(-1);\n  }\n  dist[0][0] = cost[0][0];\n\n  for (let s = 1; s <= 2 * (n - 1); s++) {\n    const iLo = Math.max(0, s - (n - 1));\n    const iHi = Math.min(n - 1, s);\n    for (let iN = iLo; iN <= iHi; iN++) {\n      const jN = s - iN;\n      const rulingCost = cost[iN][jN];\n      if (!isFinite(rulingCost)) continue;\n      let best = INF;\n      let bestDir = -1;\n      if (iN > 0 && isFinite(dist[iN - 1][jN])) {\n        const cand =\n          dist[iN - 1][jN] + rulingCost + quadTwist(P, S, iN - 1, jN, iN, jN);\n        if (cand < best) {\n          best = cand;\n          bestDir = 0;\n        }\n      }\n      if (jN > 0 && isFinite(dist[iN][jN - 1])) {\n        const cand =\n          dist[iN][jN - 1] + rulingCost + quadTwist(P, S, iN, jN - 1, iN, jN);\n        if (cand < best) {\n          best = cand;\n          bestDir = 1;\n        }\n      }\n      if (best < INF) {\n        dist[iN][jN] = best;\n        prevDir[iN][jN] = bestDir;\n      }\n    }\n  }\n\n  const path: [number, number][] = [];\n  if (isFinite(dist[n - 1][n - 1])) {\n    let ci = n - 1;\n    let cj = n - 1;\n    while (ci >= 0 && cj >= 0) {\n      path.push([ci, cj]);\n      if (ci === 0 && cj === 0) break;\n      const dir = prevDir[ci][cj];\n      if (dir === 0) ci -= 1;\n      else if (dir === 1) cj -= 1;\n      else break;\n    }\n    path.reverse();\n    return { path, totalCost: dist[n - 1][n - 1] };\n  }\n  console.warn(\"Unroll: DAG search found no path; falling back to diagonal.\");\n  for (let k = 0; k < n; k++) path.push([k, k]);\n  return { path, totalCost: INF };\n}\n\n/**\n * Locate the unfold triangle whose plane is closest to `p`, returning the\n * 2D image of `p` under that triangle's affine 3D→2D map. We prefer\n * triangles where the projected point's barycentric coordinates are all\n * within [−ε, 1+ε] (i.e. inside the triangle); among those, pick the one\n * with the smallest perpendicular distance. If none qualify, fall back to\n * the globally closest triangle and clamp.\n */\n/**\n * Safely fetch the UV coordinates of a 3D point on `face`. Returns null if\n * the point is off-surface or OCCT raises (e.g. periodic-seam glitch).\n * `face.uvCoordinates(p)` may return either a `[u, v]` tuple or an\n * object with .u/.v depending on the replicad build; normalise both.\n */\n// eslint-disable-next-line @typescript-eslint/no-explicit-any\nfunction uvAtSafe(face: any, p: T3): T2 | null {\n  try {\n    const r = face.uvCoordinates([p[0], p[1], p[2]]);\n    if (Array.isArray(r)) {\n      if (!isFinite(r[0]) || !isFinite(r[1])) return null;\n      return [r[0], r[1]];\n    }\n    if (r && typeof r.u === \"number\" && typeof r.v === \"number\") {\n      return [r.u, r.v];\n    }\n    return null;\n  } catch {\n    return null;\n  }\n}\n\n/**\n * Return the index of the unfold triangle whose UV image contains `uv`,\n * or -1 if none does. UV is a single-valued chart on the trimmed face, so\n * at most one triangle truly contains `uv`; a small ε accepts on-edge\n * points and either side resolves to the same 2D position (the affine\n * maps agree on the shared edge).\n */\nfunction findContainingTriangle(\n  uv: T2,\n  trisUV: ([T2, T2, T2] | null)[],\n): number {\n  const EPS = 1e-9;\n  for (let k = 0; k < trisUV.length; k++) {\n    const tri = trisUV[k];\n    if (!tri) continue;\n    const bary = baryUV(uv, tri[0], tri[1], tri[2]);\n    if (!bary) continue;\n    const [u, v, w] = bary;\n    if (u >= -EPS && v >= -EPS && w >= -EPS) return k;\n  }\n  return -1;\n}\n\n/**\n * Identify the best 3D triangle for a point P. We prefer the one where P\n * projects inside (positive barycentric), using physical distance to the\n * triangle plane as a tie-breaker.\n */\nfunction findBestTriangle3D(p: T3, tris3D: [T3, T3, T3][]): number {\n  let bestK = -1;\n  let minScore = Infinity;\n\n  for (let k = 0; k < tris3D.length; k++) {\n    const tri = tris3D[k];\n    const bary = bary3D(p, tri[0], tri[1], tri[2]);\n    if (!bary) continue;\n\n    const [u, v, w] = bary;\n    // Penalty for being physically outside the triangle footprint\n    const outsideDist = Math.max(0, -u, -v, -w);\n    // Distance to triangle plane\n    const planeDist = distToPlane(p, tri[0], tri[1], tri[2]);\n\n    // Combined score: proximity to plane + penalty for being outside.\n    // Being outside is penalized much more heavily than being slightly\n    // off-plane.\n    const score = planeDist + outsideDist * 1000;\n\n    if (score < minScore) {\n      minScore = score;\n      bestK = k;\n    }\n  }\n  return bestK;\n}\n\n/**\n * Project 3D point p into triangle k and return its 2D coordinates.\n */\nfunction mapWithTriangle3D(\n  p: T3,\n  k: number,\n  tris3D: [T3, T3, T3][],\n  tris2D: [T2, T2, T2][],\n): T2 {\n  const tri3 = tris3D[k];\n  const tri2 = tris2D[k];\n  const bary = bary3D(p, tri3[0], tri3[1], tri3[2]);\n  if (!bary) return [0, 0];\n\n  const [u, v, w] = bary;\n  const [a2, b2, c2] = tri2;\n\n  return [u * a2[0] + v * b2[0] + w * c2[0], u * a2[1] + v * b2[1] + w * c2[1]];\n}\n\nfunction distToPlane(p: T3, a: T3, b: T3, c: T3): number {\n  const v1 = [b[0] - a[0], b[1] - a[1], b[2] - a[2]];\n  const v2 = [c[0] - a[0], c[1] - a[1], c[2] - a[2]];\n\n  const nx = v1[1] * v2[2] - v1[2] * v2[1];\n  const ny = v1[2] * v2[0] - v1[0] * v2[2];\n  const nz = v1[0] * v2[1] - v1[1] * v2[0];\n  const nLen = Math.hypot(nx, ny, nz);\n  if (nLen === 0) return dist3(p, a);\n\n  const dx = p[0] - a[0];\n  const dy = p[1] - a[1];\n  const dz = p[2] - a[2];\n\n  return Math.abs(dx * nx + dy * ny + dz * nz) / nLen;\n}\n\n/**\n * 3D Barycentric coordinates of P in triangle (A, B, C).\n * P is projected onto the plane of ABC.\n */\nfunction bary3D(p: T3, a: T3, b: T3, c: T3): [number, number, number] | null {\n  const v0 = [b[0] - a[0], b[1] - a[1], b[2] - a[2]];\n  const v1 = [c[0] - a[0], c[1] - a[1], c[2] - a[2]];\n  const v2 = [p[0] - a[0], p[1] - a[1], p[2] - a[2]];\n\n  const d00 = v0[0] * v0[0] + v0[1] * v0[1] + v0[2] * v0[2];\n  const d01 = v0[0] * v1[0] + v0[1] * v1[1] + v0[2] * v1[2];\n  const d11 = v1[0] * v1[0] + v1[1] * v1[1] + v1[2] * v1[2];\n  const d20 = v2[0] * v0[0] + v2[1] * v0[1] + v2[2] * v0[2];\n  const d21 = v2[0] * v1[0] + v2[1] * v1[1] + v2[2] * v1[2];\n\n  const denom = d00 * d11 - d01 * d01;\n  if (Math.abs(denom) < 1e-12) return null;\n\n  const invDenom = 1.0 / denom;\n  const v = (d11 * d20 - d01 * d21) * invDenom;\n  const w = (d00 * d21 - d01 * d20) * invDenom;\n  const u = 1.0 - v - w;\n\n  return [u, v, w];\n}\n\n/**\n * Affine UV→2D map via the barycentric of `uv` in triangle `k`. Caller is\n * responsible for picking a triangle that (nearly) contains `uv`.\n */\nfunction mapWithTriangle(\n  uv: T2,\n  k: number,\n  trisUV: ([T2, T2, T2] | null)[],\n  tris2D: [T2, T2, T2][],\n): T2 {\n  const tri = trisUV[k];\n  if (!tri) return [0, 0];\n  const bary = baryUV(uv, tri[0], tri[1], tri[2]);\n  const [u, v, w] = bary ?? [1, 0, 0];\n  const [a2, b2, c2] = tris2D[k];\n  return [u * a2[0] + v * b2[0] + w * c2[0], u * a2[1] + v * b2[1] + w * c2[1]];\n}\n\n/** Signed-area barycentric of `p` in triangle (A, B, C) in 2D. Returns\n *  [u, v, w] with u+v+w=1; null on a zero-area triangle. */\nfunction baryUV(p: T2, A: T2, B: T2, C: T2): [number, number, number] | null {\n  const ax = B[0] - A[0],\n    ay = B[1] - A[1];\n  const bx = C[0] - A[0],\n    by = C[1] - A[1];\n  const denom = ax * by - ay * bx;\n  if (!(Math.abs(denom) > 0)) return null;\n  const px = p[0] - A[0],\n    py = p[1] - A[1];\n  const v = (px * by - py * bx) / denom;\n  const w = (ax * py - ay * px) / denom;\n  const u = 1 - v - w;\n  return [u, v, w];\n}\n\n/** Place a new 2D point at distance r0 from p0 and r1 from p1, on the\n * sideSign side of the directed line p0→p1 (+1 = left, −1 = right). */\nfunction circleIntersect(\n  p0: T2,\n  r0: number,\n  p1: T2,\n  r1: number,\n  sideSign: number,\n  stripIdx: number,\n): T2 {\n  const dx = p1[0] - p0[0];\n  const dy = p1[1] - p0[1];\n  const d = Math.hypot(dx, dy);\n  const sum = r0 + r1;\n  const diff = Math.abs(r0 - r1);\n  const EPS = 1e-6;\n  if (d === 0 || d > sum * (1 + EPS) || d < diff * (1 - EPS)) {\n    throw new Error(\n      `Unroll: degenerate triangle at strip ${stripIdx} ` +\n      `(r0=${r0.toFixed(4)}, r1=${r1.toFixed(4)}, hinge=${d.toFixed(4)}).`,\n    );\n  }\n  const dC = Math.max(diff, Math.min(sum, d));\n  const a = (r0 * r0 - r1 * r1 + dC * dC) / (2 * dC);\n  const h = Math.sqrt(Math.max(0, r0 * r0 - a * a));\n  const ux = dx / d;\n  const uy = dy / d;\n  const mx = p0[0] + a * ux;\n  const my = p0[1] + a * uy;\n  return [mx + h * -uy * sideSign, my + h * ux * sideSign];\n}\n",
              "compiledCode": "\"use strict\";\n/**\n * Visualises the twist (non-planarity) of a ruled surface as a colour\n * heatmap baked into the face's mesh, using the same DP-based ruling\n * framework as atomimpl2.ts.\n *\n * Each ruling in the optimal path is assigned the normal-twist cost\n * cost[i][j] from the DP grid. Mesh vertices are coloured by the cost of\n * their nearest ruling centroid in 3D (white = low twist, red = high).\n *\n *   primaryEdgeIndex → cyclic index into face.outerWire().edges; same\n *                      convention as atomimpl2.ts. Pass a negative number\n *                      to auto-select the lowest-cost primary edge.\n */\n// eslint-disable-next-line @typescript-eslint/no-unused-vars\nfunction run(surface, numRulings = 24, primaryEdgeIndex = 0) {\n    if (!Number.isFinite(numRulings) || numRulings < 2) {\n        throw new Error(\"Twist heatmap: numRulings must be an integer ≥ 2.\");\n    }\n    if (!Number.isFinite(primaryEdgeIndex)) {\n        throw new Error(\"Twist heatmap: primaryEdgeIndex must be a number.\");\n    }\n    const results = [];\n    // eslint-disable-next-line @typescript-eslint/no-explicit-any\n    surface.onLeafs((leaf) => {\n        // eslint-disable-next-line @typescript-eslint/no-explicit-any\n        if (leaf.geometry instanceof replicad.Drawing) {\n            console.warn(\"Twist heatmap: drawings cannot have a heatmap computed\");\n            return leaf;\n        }\n        // eslint-disable-next-line @typescript-eslint/no-explicit-any\n        const faces = \n        // eslint-disable-next-line @typescript-eslint/no-explicit-any\n        leaf.geometry instanceof replicad.Face\n            ? // eslint-disable-next-line @typescript-eslint/no-explicit-any\n                [leaf.geometry]\n            : // eslint-disable-next-line @typescript-eslint/no-explicit-any\n                (leaf.geometry.faces ?? []);\n        for (const face of faces) {\n            results.push(buildHeatmapForFace(face, leaf, numRulings, primaryEdgeIndex));\n        }\n        return leaf;\n    });\n    // eslint-disable-next-line @typescript-eslint/no-explicit-any\n    return new Assembly({ geometry: results });\n}\n/**\n * Probe every outer edge at AUTO_PROBE_N rulings and return the index with\n * the lowest total ruling cost. Named distinctly from atomimpl2's\n * selectBestPrimaryEdge to avoid the shared global-scope collision.\n */\nconst HEATMAP_PROBE_N = 8;\n// eslint-disable-next-line @typescript-eslint/no-explicit-any\nfunction selectBestHeatmapEdge(face) {\n    // eslint-disable-next-line @typescript-eslint/no-explicit-any\n    const allEdges = face.clone().outerWire().edges ?? [];\n    const m = allEdges.length;\n    let bestIdx = 0;\n    let bestCost = Infinity;\n    for (let k = 0; k < m; k++) {\n        try {\n            // partitionOuterWire / samplePrimary / sampleSecondary / buildCostGrid /\n            // findOptimalRulingPath are all in global scope from atomimpl2.ts.\n            // eslint-disable-next-line @typescript-eslint/no-explicit-any\n            const { primary, secondaryEdges } = partitionOuterWire(face, k);\n            // eslint-disable-next-line @typescript-eslint/no-explicit-any\n            const P3 = samplePrimary(primary, HEATMAP_PROBE_N);\n            // eslint-disable-next-line @typescript-eslint/no-explicit-any\n            const S3 = sampleSecondary(secondaryEdges, HEATMAP_PROBE_N);\n            // eslint-disable-next-line @typescript-eslint/no-explicit-any\n            const cost = buildCostGrid(face, P3, S3);\n            // eslint-disable-next-line @typescript-eslint/no-explicit-any\n            const { totalCost } = findOptimalRulingPath(cost, P3, S3);\n            if (totalCost < bestCost) {\n                bestCost = totalCost;\n                bestIdx = k;\n            }\n        }\n        catch {\n            // degenerate partition; skip\n        }\n    }\n    console.log(`Twist heatmap auto-select: chose primaryEdgeIndex=${bestIdx} ` +\n        `(cost=${bestCost.toExponential(2)}) from ${m} candidates`);\n    return bestIdx;\n}\n/**\n * Run the DP ruling algorithm on a single Face and return an Assembly whose\n * geometry is the original face with a colour heatmap baked into its mesh.\n */\nfunction buildHeatmapForFace(\n// eslint-disable-next-line @typescript-eslint/no-explicit-any\nface, sourceLeaf, numRulings, primaryEdgeIndex) {\n    const n = Math.max(2, Math.floor(numRulings));\n    const resolvedEdgeIndex = primaryEdgeIndex < 0 ? selectBestHeatmapEdge(face) : primaryEdgeIndex;\n    // eslint-disable-next-line @typescript-eslint/no-explicit-any\n    const { primary, secondaryEdges, pIdx } = partitionOuterWire(face, resolvedEdgeIndex);\n    // eslint-disable-next-line @typescript-eslint/no-explicit-any\n    const P3 = samplePrimary(primary, n);\n    // eslint-disable-next-line @typescript-eslint/no-explicit-any\n    const S3 = sampleSecondary(secondaryEdges, n);\n    // eslint-disable-next-line @typescript-eslint/no-explicit-any\n    const cost = buildCostGrid(face, P3, S3);\n    // eslint-disable-next-line @typescript-eslint/no-explicit-any\n    const { path, totalCost } = findOptimalRulingPath(cost, P3, S3);\n    console.log(`Twist heatmap: primary=edge[${pIdx}], n=${n}, ` +\n        `path=${path.length} rulings, total cost=${totalCost.toExponential(2)}`);\n    // Per-ruling cost and 3D centroid for mesh vertex assignment.\n    const rulingCosts = path.map(([i, j]) => cost[i][j]);\n    const rulingCentroids = path.map(([i, j]) => [\n        (P3[i][0] + S3[j][0]) / 2,\n        (P3[i][1] + S3[j][1]) / 2,\n        (P3[i][2] + S3[j][2]) / 2,\n    ]);\n    return new Assembly({\n        ...sourceLeaf,\n        geometry: face,\n        tags: [\n            ...(sourceLeaf.tags ?? []),\n            \"heatmap:twist\",\n            \"ruling-primary:\" + pIdx,\n        ],\n        metadata: {\n            meshOverride: buildHeatmapMeshOverride(face, rulingCosts, rulingCentroids),\n        },\n    });\n}\n// ─── meshOverride baking ──────────────────────────────────────────────────\n//\n// Colour the face's own OCCT tessellation by ruling cost. Every mesh vertex\n// is assigned the cost of its nearest ruling centroid in 3D, then painted\n// with a white→red gradient (white = low twist / near-developable,\n// red = high twist). Reusing the face's existing mesh avoids re-tessellation.\nfunction buildHeatmapMeshOverride(\n// eslint-disable-next-line @typescript-eslint/no-explicit-any\nface, rulingCosts, rulingCentroids) {\n    const faces = face.mesh({ tolerance: 0.1, angularTolerance: 0.5 });\n    const edges = face.meshEdges({ tolerance: 0.1, angularTolerance: 0.5 });\n    const [r0, g0, b0] = hexToRgb(\"#ffffff\");\n    const [r1, g1, b1] = hexToRgb(\"#ff0000\");\n    // Normalise so the full dynamic range of this face fills the colormap.\n    let costMin = Infinity;\n    let costMax = -Infinity;\n    for (const c of rulingCosts) {\n        if (c < costMin)\n            costMin = c;\n        if (c > costMax)\n            costMax = c;\n    }\n    const costSpan = costMax - costMin;\n    const numVerts = faces.vertices.length / 3;\n    const vertexColors = new Array(numVerts * 3);\n    for (let v = 0; v < numVerts; v++) {\n        const px = faces.vertices[v * 3];\n        const py = faces.vertices[v * 3 + 1];\n        const pz = faces.vertices[v * 3 + 2];\n        // Find nearest ruling centroid in 3D.\n        let nearestIdx = 0;\n        let nearestDist = Infinity;\n        for (let k = 0; k < rulingCentroids.length; k++) {\n            const c = rulingCentroids[k];\n            const d = Math.hypot(px - c[0], py - c[1], pz - c[2]);\n            if (d < nearestDist) {\n                nearestDist = d;\n                nearestIdx = k;\n            }\n        }\n        let s = costSpan > 0 ? (rulingCosts[nearestIdx] - costMin) / costSpan : 0;\n        if (s < 0)\n            s = 0;\n        else if (s > 1)\n            s = 1;\n        vertexColors[v * 3] = r0 + (r1 - r0) * s;\n        vertexColors[v * 3 + 1] = g0 + (g1 - g0) * s;\n        vertexColors[v * 3 + 2] = b0 + (b1 - b0) * s;\n    }\n    return {\n        faces,\n        edges,\n        // Plain array so metadata.meshOverride survives the JSON round-trip.\n        vertexColors,\n    };\n}\nfunction hexToRgb(hex) {\n    const h = hex.replace(\"#\", \"\");\n    return [\n        parseInt(h.slice(0, 2), 16) / 255,\n        parseInt(h.slice(2, 4), 16) / 255,\n        parseInt(h.slice(4, 6), 16) / 255,\n    ];\n}\nfunction toT3(v) {\n    return [v.x, v.y, v.z];\n}\nfunction dist3(a, b) {\n    return Math.hypot(a[0] - b[0], a[1] - b[1], a[2] - b[2]);\n}\nfunction partitionOuterWire(\n// eslint-disable-next-line @typescript-eslint/no-explicit-any\nface, primaryEdgeIndex) {\n    const outerWire = face.clone().outerWire();\n    // eslint-disable-next-line @typescript-eslint/no-explicit-any\n    const allEdges = outerWire.edges ?? [];\n    const m = allEdges.length;\n    const pIdx = ((Math.floor(primaryEdgeIndex) % m) + m) % m;\n    const primary = allEdges[pIdx];\n    const excludedIdx = new Set([pIdx]);\n    if (primary.isClosed) {\n        if (pIdx == 0) {\n            excludedIdx.add(1);\n        }\n        else if (pIdx == allEdges.length - 1) {\n            excludedIdx.add(allEdges.length - 2);\n        }\n        else {\n            console.warn(\"found a closed face with two neighbors..\");\n        }\n    }\n    else {\n        excludedIdx.add((pIdx - 1 + m) % m);\n        excludedIdx.add((pIdx + 1) % m);\n    }\n    // eslint-disable-next-line @typescript-eslint/no-explicit-any\n    const secondaryEdges = [];\n    for (let k = 0; k < m; k++) {\n        const idx = (pIdx + 2 + k) % m;\n        if (!excludedIdx.has(idx))\n            secondaryEdges.push(allEdges[idx]);\n    }\n    if (secondaryEdges.length === 0) {\n        console.warn(\"less than 4 edges total. this may cause bugs later\");\n        secondaryEdges.push(allEdges[(pIdx + 1) % m]);\n    }\n    return { primary, secondaryEdges, pIdx };\n}\n// eslint-disable-next-line @typescript-eslint/no-explicit-any\nfunction samplePrimary(primary, n) {\n    const out = new Array(n);\n    for (let i = 0; i < n; i++) {\n        const t = n === 1 ? 0 : i / (n - 1);\n        out[i] = toT3(primary.pointAt(t));\n    }\n    return out;\n}\nfunction sampleSecondary(\n// eslint-disable-next-line @typescript-eslint/no-explicit-any\nsecondaryEdges, n) {\n    const secLengths = secondaryEdges.map((e) => e.length);\n    const secTotal = secLengths.reduce((a, b) => a + b, 0);\n    if (!(secTotal > 0)) {\n        throw new Error(\"Unroll surface: secondary edges have zero total length.\");\n    }\n    const perEdge = secondaryEdges.map((_, k) => Math.max(1, Math.round((n * secLengths[k]) / secTotal)));\n    let perSum = perEdge.reduce((a, b) => a + b, 0);\n    while (perSum !== n) {\n        let bestK = 0;\n        let bestLen = -1;\n        for (let k = 0; k < secondaryEdges.length; k++) {\n            if (secLengths[k] > bestLen) {\n                bestLen = secLengths[k];\n                bestK = k;\n            }\n        }\n        if (perSum < n) {\n            perEdge[bestK] += 1;\n            perSum += 1;\n        }\n        else if (perEdge[bestK] > 1) {\n            perEdge[bestK] -= 1;\n            perSum -= 1;\n        }\n        else {\n            break;\n        }\n    }\n    const samples = [];\n    for (let k = 0; k < secondaryEdges.length; k++) {\n        const e = secondaryEdges[k];\n        const cnt = perEdge[k];\n        for (let i = 0; i < cnt; i++) {\n            const t = (i + 0.5) / cnt;\n            samples.push(toT3(e.pointAt(t)));\n        }\n    }\n    let cursor = 0;\n    for (let k = 0; k < secondaryEdges.length - 1; k++) {\n        cursor += perEdge[k];\n        const sharedVertex = toT3(secondaryEdges[k].endPoint);\n        const a = cursor - 1;\n        const b = cursor;\n        if (a < 0 || b >= samples.length)\n            continue;\n        const dA = dist3(samples[a], sharedVertex);\n        const dB = dist3(samples[b], sharedVertex);\n        if (dA <= dB)\n            samples[a] = sharedVertex;\n        else\n            samples[b] = sharedVertex;\n    }\n    return samples;\n}\n// eslint-disable-next-line @typescript-eslint/no-explicit-any\nfunction normalAtSafe(face, p) {\n    try {\n        const nv = face.normalAt(p);\n        const x = nv.x, y = nv.y, z = nv.z;\n        const len = Math.hypot(x, y, z);\n        if (!(len > 0))\n            return null;\n        return [x / len, y / len, z / len];\n    }\n    catch {\n        return null;\n    }\n}\nfunction buildCostGrid(\n// eslint-disable-next-line @typescript-eslint/no-explicit-any\nface, primarySamples, secondarySamples) {\n    const n = primarySamples.length;\n    const ns = secondarySamples.length;\n    const primaryNormals = primarySamples.map((p) => normalAtSafe(face, p));\n    const secondaryNormals = secondarySamples.map((p) => normalAtSafe(face, p));\n    const cost = new Array(n);\n    for (let i = 0; i < n; i++) {\n        const row = new Array(ns);\n        const nA = primaryNormals[i];\n        for (let j = 0; j < ns; j++) {\n            const nB = secondaryNormals[j];\n            if (!nA || !nB) {\n                row[j] = Infinity;\n                continue;\n            }\n            const dot = nA[0] * nB[0] + nA[1] * nB[1] + nA[2] * nB[2];\n            row[j] = 1 - Math.abs(dot);\n        }\n        cost[i] = row;\n    }\n    return cost;\n}\nfunction quadTwist(P, S, i, j, iN, jN) {\n    const A = P[i];\n    const Ap = P[iN];\n    const B = S[j];\n    const Bp = S[jN];\n    const e1x = Ap[0] - A[0], e1y = Ap[1] - A[1], e1z = Ap[2] - A[2];\n    const e2x = Bp[0] - A[0], e2y = Bp[1] - A[1], e2z = Bp[2] - A[2];\n    const e3x = B[0] - A[0], e3y = B[1] - A[1], e3z = B[2] - A[2];\n    const nx = e1y * e2z - e1z * e2y;\n    const ny = e1z * e2x - e1x * e2z;\n    const nz = e1x * e2y - e1y * e2x;\n    const nMag = Math.hypot(nx, ny, nz);\n    const height = nMag > 0 ? Math.abs(nx * e3x + ny * e3y + nz * e3z) / nMag : 0;\n    const avgEdge = 0.25 * (dist3(A, Ap) + dist3(Ap, Bp) + dist3(Bp, B) + dist3(B, A));\n    return avgEdge > 0 ? height / avgEdge : 0;\n}\n/**\n * 2-neighbour anti-diagonal DP: from (i, j) you may only advance to\n * (i+1, j) or (i, j+1). Every path has 2(n-1) steps and emits 2n-1 rulings.\n * Identical to the implementation in atomimpl.ts.\n */\nfunction findOptimalRulingPath(cost, P, S) {\n    const n = cost.length;\n    const INF = Number.POSITIVE_INFINITY;\n    const dist = new Array(n);\n    const prevDir = new Array(n);\n    for (let i = 0; i < n; i++) {\n        dist[i] = new Array(n).fill(INF);\n        prevDir[i] = new Array(n).fill(-1);\n    }\n    dist[0][0] = cost[0][0];\n    for (let s = 1; s <= 2 * (n - 1); s++) {\n        const iLo = Math.max(0, s - (n - 1));\n        const iHi = Math.min(n - 1, s);\n        for (let iN = iLo; iN <= iHi; iN++) {\n            const jN = s - iN;\n            const rulingCost = cost[iN][jN];\n            if (!isFinite(rulingCost))\n                continue;\n            let best = INF;\n            let bestDir = -1;\n            if (iN > 0 && isFinite(dist[iN - 1][jN])) {\n                const cand = dist[iN - 1][jN] + rulingCost + quadTwist(P, S, iN - 1, jN, iN, jN);\n                if (cand < best) {\n                    best = cand;\n                    bestDir = 0;\n                }\n            }\n            if (jN > 0 && isFinite(dist[iN][jN - 1])) {\n                const cand = dist[iN][jN - 1] + rulingCost + quadTwist(P, S, iN, jN - 1, iN, jN);\n                if (cand < best) {\n                    best = cand;\n                    bestDir = 1;\n                }\n            }\n            if (best < INF) {\n                dist[iN][jN] = best;\n                prevDir[iN][jN] = bestDir;\n            }\n        }\n    }\n    const path = [];\n    if (isFinite(dist[n - 1][n - 1])) {\n        let ci = n - 1;\n        let cj = n - 1;\n        while (ci >= 0 && cj >= 0) {\n            path.push([ci, cj]);\n            if (ci === 0 && cj === 0)\n                break;\n            const dir = prevDir[ci][cj];\n            if (dir === 0)\n                ci -= 1;\n            else if (dir === 1)\n                cj -= 1;\n            else\n                break;\n        }\n        path.reverse();\n        return { path, totalCost: dist[n - 1][n - 1] };\n    }\n    console.warn(\"Unroll: DAG search found no path; falling back to diagonal.\");\n    for (let k = 0; k < n; k++)\n        path.push([k, k]);\n    return { path, totalCost: INF };\n}\n/**\n * Locate the unfold triangle whose plane is closest to `p`, returning the\n * 2D image of `p` under that triangle's affine 3D→2D map. We prefer\n * triangles where the projected point's barycentric coordinates are all\n * within [−ε, 1+ε] (i.e. inside the triangle); among those, pick the one\n * with the smallest perpendicular distance. If none qualify, fall back to\n * the globally closest triangle and clamp.\n */\n/**\n * Safely fetch the UV coordinates of a 3D point on `face`. Returns null if\n * the point is off-surface or OCCT raises (e.g. periodic-seam glitch).\n * `face.uvCoordinates(p)` may return either a `[u, v]` tuple or an\n * object with .u/.v depending on the replicad build; normalise both.\n */\n// eslint-disable-next-line @typescript-eslint/no-explicit-any\nfunction uvAtSafe(face, p) {\n    try {\n        const r = face.uvCoordinates([p[0], p[1], p[2]]);\n        if (Array.isArray(r)) {\n            if (!isFinite(r[0]) || !isFinite(r[1]))\n                return null;\n            return [r[0], r[1]];\n        }\n        if (r && typeof r.u === \"number\" && typeof r.v === \"number\") {\n            return [r.u, r.v];\n        }\n        return null;\n    }\n    catch {\n        return null;\n    }\n}\n/**\n * Return the index of the unfold triangle whose UV image contains `uv`,\n * or -1 if none does. UV is a single-valued chart on the trimmed face, so\n * at most one triangle truly contains `uv`; a small ε accepts on-edge\n * points and either side resolves to the same 2D position (the affine\n * maps agree on the shared edge).\n */\nfunction findContainingTriangle(uv, trisUV) {\n    const EPS = 1e-9;\n    for (let k = 0; k < trisUV.length; k++) {\n        const tri = trisUV[k];\n        if (!tri)\n            continue;\n        const bary = baryUV(uv, tri[0], tri[1], tri[2]);\n        if (!bary)\n            continue;\n        const [u, v, w] = bary;\n        if (u >= -EPS && v >= -EPS && w >= -EPS)\n            return k;\n    }\n    return -1;\n}\n/**\n * Identify the best 3D triangle for a point P. We prefer the one where P\n * projects inside (positive barycentric), using physical distance to the\n * triangle plane as a tie-breaker.\n */\nfunction findBestTriangle3D(p, tris3D) {\n    let bestK = -1;\n    let minScore = Infinity;\n    for (let k = 0; k < tris3D.length; k++) {\n        const tri = tris3D[k];\n        const bary = bary3D(p, tri[0], tri[1], tri[2]);\n        if (!bary)\n            continue;\n        const [u, v, w] = bary;\n        // Penalty for being physically outside the triangle footprint\n        const outsideDist = Math.max(0, -u, -v, -w);\n        // Distance to triangle plane\n        const planeDist = distToPlane(p, tri[0], tri[1], tri[2]);\n        // Combined score: proximity to plane + penalty for being outside.\n        // Being outside is penalized much more heavily than being slightly\n        // off-plane.\n        const score = planeDist + outsideDist * 1000;\n        if (score < minScore) {\n            minScore = score;\n            bestK = k;\n        }\n    }\n    return bestK;\n}\n/**\n * Project 3D point p into triangle k and return its 2D coordinates.\n */\nfunction mapWithTriangle3D(p, k, tris3D, tris2D) {\n    const tri3 = tris3D[k];\n    const tri2 = tris2D[k];\n    const bary = bary3D(p, tri3[0], tri3[1], tri3[2]);\n    if (!bary)\n        return [0, 0];\n    const [u, v, w] = bary;\n    const [a2, b2, c2] = tri2;\n    return [u * a2[0] + v * b2[0] + w * c2[0], u * a2[1] + v * b2[1] + w * c2[1]];\n}\nfunction distToPlane(p, a, b, c) {\n    const v1 = [b[0] - a[0], b[1] - a[1], b[2] - a[2]];\n    const v2 = [c[0] - a[0], c[1] - a[1], c[2] - a[2]];\n    const nx = v1[1] * v2[2] - v1[2] * v2[1];\n    const ny = v1[2] * v2[0] - v1[0] * v2[2];\n    const nz = v1[0] * v2[1] - v1[1] * v2[0];\n    const nLen = Math.hypot(nx, ny, nz);\n    if (nLen === 0)\n        return dist3(p, a);\n    const dx = p[0] - a[0];\n    const dy = p[1] - a[1];\n    const dz = p[2] - a[2];\n    return Math.abs(dx * nx + dy * ny + dz * nz) / nLen;\n}\n/**\n * 3D Barycentric coordinates of P in triangle (A, B, C).\n * P is projected onto the plane of ABC.\n */\nfunction bary3D(p, a, b, c) {\n    const v0 = [b[0] - a[0], b[1] - a[1], b[2] - a[2]];\n    const v1 = [c[0] - a[0], c[1] - a[1], c[2] - a[2]];\n    const v2 = [p[0] - a[0], p[1] - a[1], p[2] - a[2]];\n    const d00 = v0[0] * v0[0] + v0[1] * v0[1] + v0[2] * v0[2];\n    const d01 = v0[0] * v1[0] + v0[1] * v1[1] + v0[2] * v1[2];\n    const d11 = v1[0] * v1[0] + v1[1] * v1[1] + v1[2] * v1[2];\n    const d20 = v2[0] * v0[0] + v2[1] * v0[1] + v2[2] * v0[2];\n    const d21 = v2[0] * v1[0] + v2[1] * v1[1] + v2[2] * v1[2];\n    const denom = d00 * d11 - d01 * d01;\n    if (Math.abs(denom) < 1e-12)\n        return null;\n    const invDenom = 1.0 / denom;\n    const v = (d11 * d20 - d01 * d21) * invDenom;\n    const w = (d00 * d21 - d01 * d20) * invDenom;\n    const u = 1.0 - v - w;\n    return [u, v, w];\n}\n/**\n * Affine UV→2D map via the barycentric of `uv` in triangle `k`. Caller is\n * responsible for picking a triangle that (nearly) contains `uv`.\n */\nfunction mapWithTriangle(uv, k, trisUV, tris2D) {\n    const tri = trisUV[k];\n    if (!tri)\n        return [0, 0];\n    const bary = baryUV(uv, tri[0], tri[1], tri[2]);\n    const [u, v, w] = bary ?? [1, 0, 0];\n    const [a2, b2, c2] = tris2D[k];\n    return [u * a2[0] + v * b2[0] + w * c2[0], u * a2[1] + v * b2[1] + w * c2[1]];\n}\n/** Signed-area barycentric of `p` in triangle (A, B, C) in 2D. Returns\n *  [u, v, w] with u+v+w=1; null on a zero-area triangle. */\nfunction baryUV(p, A, B, C) {\n    const ax = B[0] - A[0], ay = B[1] - A[1];\n    const bx = C[0] - A[0], by = C[1] - A[1];\n    const denom = ax * by - ay * bx;\n    if (!(Math.abs(denom) > 0))\n        return null;\n    const px = p[0] - A[0], py = p[1] - A[1];\n    const v = (px * by - py * bx) / denom;\n    const w = (ax * py - ay * px) / denom;\n    const u = 1 - v - w;\n    return [u, v, w];\n}\n/** Place a new 2D point at distance r0 from p0 and r1 from p1, on the\n * sideSign side of the directed line p0→p1 (+1 = left, −1 = right). */\nfunction circleIntersect(p0, r0, p1, r1, sideSign, stripIdx) {\n    const dx = p1[0] - p0[0];\n    const dy = p1[1] - p0[1];\n    const d = Math.hypot(dx, dy);\n    const sum = r0 + r1;\n    const diff = Math.abs(r0 - r1);\n    const EPS = 1e-6;\n    if (d === 0 || d > sum * (1 + EPS) || d < diff * (1 - EPS)) {\n        throw new Error(`Unroll: degenerate triangle at strip ${stripIdx} ` +\n            `(r0=${r0.toFixed(4)}, r1=${r1.toFixed(4)}, hinge=${d.toFixed(4)}).`);\n    }\n    const dC = Math.max(diff, Math.min(sum, d));\n    const a = (r0 * r0 - r1 * r1 + dC * dC) / (2 * dC);\n    const h = Math.sqrt(Math.max(0, r0 * r0 - a * a));\n    const ux = dx / d;\n    const uy = dy / d;\n    const mx = p0[0] + a * ux;\n    const my = p0[1] + a * uy;\n    return [mx + h * -uy * sideSign, my + h * ux * sideSign];\n}\n"
            },
