            {
              "atomType": "Code",
              "x": 0.5924479166666666,
              "y": 0.7083333333333333,
              "uniqueID": "id-43754",
              "ioValues": [
                {
                  "name": "primaryGuideWire",
                  "ioValue": "__GEOMETRY_INPUT__"
                },
                {
                  "name": "secondaryGuideWire",
                  "ioValue": "__GEOMETRY_INPUT__"
                },
