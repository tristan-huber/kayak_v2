            }
          ],
          "interpreterVersion": 1,
          "code": "function run(a: Assembly) {\n  let i = 0;\n  const t = []\n  a.onLeafs((leaf) => {\n    i+= 1\n    t.push(...leaf.tags)\n    return leaf;\n  })\n  console.log(\"found tags; \", t)\n  console.log(`total of ${i} leafs, top-level has ${a.geometry.length} children`)\n  console.log(a)\n  return a\n}",
          "compiledCode": "\"use strict\";\nfunction run(a) {\n    let i = 0;\n    const t = [];\n    a.onLeafs((leaf) => {\n        i += 1;\n        t.push(...leaf.tags);\n        return leaf;\n    });\n    console.log(\"found tags; \", t);\n    console.log(`total of ${i} leafs, top-level has ${a.geometry.length} children`);\n    console.log(a);\n    return a;\n}\n"
        },
        {
          "atomType": "Code",
          "x": 0.46289062500000006,
          "y": 0.4642857142857143,
          "uniqueID": "id-42137",
          "ioValues": [
            {
              "name": "profile",
              "ioValue": "__GEOMETRY_INPUT__"
            },
            {
              "name": "edges",
              "ioValue": "__GEOMETRY_INPUT__"
            }
          ],
          "interpreterVersion": 1,
          "code": "function run(profile: Assembly, edges: Assembly) {\n  let extWires = edges.getSelectedEdges().map((edge) => replicad.assembleWire([edge]));\n  if (extWires.length == 0) {\n    edges.onLeafs((leaf) => {\n      if (leaf.geometry instanceof replicad.Wire) {\n        extWires.push(leaf.geometry)\n      }\n      return leaf;\n    })\n  }\n  if (extWires.length == 0) {\n    throw new Error(\"edges must be either an assembly with selected edges or an assembly of wires. was neither. No edges to loft along.\")\n  }\n  if (extWires.length > 2) {\n    throw new Error(\"loft between requires exactly 1 or two wires, got: \", extWires.length)\n  }\n  console.log(extWires)\n  return profile.onLeafs((leaf) => {\n    const primaryWire = extWires[0]\n    const result = replicad.genericSweep(leaf.geometry, primaryWire,\n      {\n        frenet: false,\n        auxiliarySpine: extWires.length == 2 ? extWires[1] : undefined,\n        law: null,\n        transitionMode: \"right\",\n        forceProfileSpineOthogonality: true\n      },\n      false)\n    \n    return new Assembly({...leaf, geometry: result })\n  })\n}",
          "compiledCode": "\"use strict\";\nfunction run(profile, edges) {\n    let extWires = edges.getSelectedEdges().map((edge) => replicad.assembleWire([edge]));\n    if (extWires.length == 0) {\n        edges.onLeafs((leaf) => {\n            if (leaf.geometry instanceof replicad.Wire) {\n                extWires.push(leaf.geometry);\n            }\n            return leaf;\n        });\n    }\n    if (extWires.length == 0) {\n        throw new Error(\"edges must be either an assembly with selected edges or an assembly of wires. was neither. No edges to loft along.\");\n    }\n    if (extWires.length > 2) {\n        throw new Error(\"loft between requires exactly 1 or two wires, got: \", extWires.length);\n    }\n    console.log(extWires);\n    return profile.onLeafs((leaf) => {\n        const primaryWire = extWires[0];\n        const result = replicad.genericSweep(leaf.geometry, primaryWire, {\n            frenet: false,\n            auxiliarySpine: extWires.length == 2 ? extWires[1] : undefined,\n            law: null,\n            transitionMode: \"right\",\n            forceProfileSpineOthogonality: true\n        }, false);\n        return new Assembly({ ...leaf, geometry: result });\n    });\n}\n"
