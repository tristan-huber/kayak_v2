          "interpreterVersion": 1,
          "code": "function run(\n  face: Assembly,\n  drawingsAssembly: Assembly,\n): Assembly {\n  if (!face.isLeaf()) {\n    throw new Error(\"face must be singleton leaf\")\n  }\n  let replFace: replicad.Face;\n  if (face.geometry instanceof replicad.Face) {\n    replFace = face.geometry\n  } else {\n    throw new Error(\"Face must be a bare face\")\n  }\n\n  const targetCenter = replFace.pointOnSurface(0.5, 0.5)\n  const targetNormal = replFace.normalAt(targetCenter);\n\n  const result = drawingsAssembly.onLeafs((leaf) => {\n    const baseCenter = leaf.plane.origin;\n    const baseNormal = leaf.plane.zDir;\n\n    let newPlane = leaf.plane.pivot(baseNormal.getAngle(targetNormal), baseNormal.cross(targetNormal))\n    newPlane = newPlane.translate(targetCenter.add(baseCenter.multiply(-1)))\n\n    console.log(replFace.UVBounds)\n    console.log(replFace.boundingBox.bounds)\n    console.log(replFace.uvCoordinates(replFace.boundingBox.center))\n    replFace.edges.map((e) => {console.log(e.length)})\n\n    newPlane = replicad.makePlaneFromFace(replFace, [0.5,0.5])\n\n    return new Assembly({\n      ...leaf,\n      plane: newPlane\n    })\n  })\n\n  if (result != null) {\n    return result\n  } else {\n    throw new Error(\"result unexpectedly null\")\n  }\n}",
          "compiledCode": "\"use strict\";\nfunction run(face, drawingsAssembly) {\n    if (!face.isLeaf()) {\n        throw new Error(\"face must be singleton leaf\");\n    }\n    let replFace;\n    if (face.geometry instanceof replicad.Face) {\n        replFace = face.geometry;\n    }\n    else {\n        throw new Error(\"Face must be a bare face\");\n    }\n    const targetCenter = replFace.pointOnSurface(0.5, 0.5);\n    const targetNormal = replFace.normalAt(targetCenter);\n    const result = drawingsAssembly.onLeafs((leaf) => {\n        const baseCenter = leaf.plane.origin;\n        const baseNormal = leaf.plane.zDir;\n        let newPlane = leaf.plane.pivot(baseNormal.getAngle(targetNormal), baseNormal.cross(targetNormal));\n        newPlane = newPlane.translate(targetCenter.add(baseCenter.multiply(-1)));\n        console.log(replFace.UVBounds);\n        console.log(replFace.boundingBox.bounds);\n        console.log(replFace.uvCoordinates(replFace.boundingBox.center));\n        replFace.edges.map((e) => { console.log(e.length); });\n        newPlane = replicad.makePlaneFromFace(replFace, [0.5, 0.5]);\n        return new Assembly({\n            ...leaf,\n            plane: newPlane\n        });\n    });\n    if (result != null) {\n        return result;\n    }\n    else {\n        throw new Error(\"result unexpectedly null\");\n    }\n}\n"
